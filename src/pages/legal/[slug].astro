---
// Pages légales et informatives (CGV, confidentialité…), rédigées dans le back-office (Contenus › Pages).
import Layout from '../../layouts/Layout.astro';
import ArticleView from '../../components/ArticleView.astro';
import { getPublishedPage } from '../../lib/content';
import { plainText } from '../../lib/markdown';
import { findRedirect } from '../../lib/redirects';

const page = await getPublishedPage(Astro.params.slug!);
if (!page) {
  const redirect = await findRedirect(Astro.url.pathname);
  if (redirect) return Astro.redirect(redirect.to, redirect.status as 301);
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
const url = new URL(`/legal/${page.slug}`, Astro.site).href;
---

<Layout title={page.seoTitle || page.title} description={page.seoDescription || page.excerpt || plainText(page.body, 160)}>
  <ArticleView content={page} url={url} />
</Layout>

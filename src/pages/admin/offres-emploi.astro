---
// Offres d'emploi de la page Carrières : ajout, modification, publication, suppression.
import AdminLayout from '../../components/AdminLayout.astro';
import { bool, deny, int, str } from '../../lib/admin';
import { audit } from '../../lib/audit';
import { listJobs, saveJobs, type Job } from '../../lib/jobs';

const me = Astro.locals.user!;
const denied = deny(me, { content: ['update'] });
if (denied) return denied;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = str(form, 'action');
  const id = str(form, 'id', 80);
  const jobs = [...(await listJobs())];
  if (action === 'delete') {
    await saveJobs(
      jobs.filter((j) => j.id !== id),
      me.id,
    );
  } else {
    const values = {
      title: str(form, 'title', 120),
      place: str(form, 'place', 80),
      contract: str(form, 'contract', 60),
      text: str(form, 'text', 1000),
      position: int(form, 'position') ?? 0,
      published: bool(form, 'published'),
    };
    if (values.title.length < 3) error = 'Indiquez l’intitulé du poste.';
    else if (action === 'create') await saveJobs([...jobs, { id: crypto.randomUUID(), ...values }], me.id);
    else if (!jobs.some((j) => j.id === id)) error = 'Cette offre n’existe plus.';
    else await saveJobs(jobs.map((j): Job => (j.id === id ? { ...j, ...values } : j)), me.id);
  }
  if (!error) {
    await audit({ actorId: me.id, action: `offre-emploi-${action}`, target: id || undefined, ipAddress: Astro.clientAddress });
    return Astro.redirect('/admin/offres-emploi?ok=1', 303);
  }
}

const jobs = await listJobs();
---

<AdminLayout title="Offres d'emploi">
  {Astro.url.searchParams.has('ok') && <p class="alert alert-success mb-4">Offres mises à jour. Visibles sur le site d'ici une minute.</p>}
  {error && <p class="alert alert-error mb-4" role="alert">{error}</p>}

  <p class="hint mb-4">
    Offres affichées sur la page <a href="/carrieres" target="_blank" class="font-semibold underline">Carrières ↗</a> et proposées dans le formulaire de candidature. Les autres textes de la page : Textes du site › Carrières.
  </p>

  <div class="mb-8 space-y-2">
    {jobs.length === 0 && <p class="card p-4 text-muted">Aucune offre pour le moment. La page Carrières propose alors la candidature spontanée.</p>}
    {
      jobs.map((j) => (
        <details class="card p-4">
          <summary class="cursor-pointer font-semibold">
            {j.position}. {j.title} <span class="font-normal text-muted">· {[j.place, j.contract].filter(Boolean).join(' · ')}</span>
            {!j.published && <span class="badge badge-rupture ml-2">Masquée</span>}
          </summary>
          <form method="post" class="mt-3 grid gap-3 sm:grid-cols-4">
            <input type="hidden" name="id" value={j.id} />
            <label class="block sm:col-span-3"><span class="label">Intitulé du poste</span><input name="title" value={j.title} required maxlength="120" class="input !py-2" /></label>
            <label class="block"><span class="label">Ordre</span><input name="position" value={j.position} inputmode="numeric" class="input !py-2" /></label>
            <label class="block sm:col-span-2"><span class="label">Lieu</span><input name="place" value={j.place} maxlength="80" class="input !py-2" /></label>
            <label class="block sm:col-span-2"><span class="label">Contrat</span><input name="contract" value={j.contract} maxlength="60" class="input !py-2" /></label>
            <label class="block sm:col-span-4"><span class="label">Description</span><textarea name="text" rows="3" maxlength="1000" class="input">{j.text}</textarea></label>
            <label class="flex items-end gap-2 pb-2 text-sm"><input type="checkbox" name="published" checked={j.published} />Publiée</label>
            <div class="flex items-end gap-2 sm:col-span-3">
              <button name="action" value="update" class="btn btn-primary btn-sm">Enregistrer</button>
              <button name="action" value="delete" formnovalidate class="btn btn-ghost btn-sm text-danger" data-confirm="Supprimer cette offre ?">Supprimer</button>
            </div>
          </form>
        </details>
      ))
    }
  </div>

  <form method="post" class="card grid gap-3 p-5 sm:grid-cols-4">
    <h2 class="text-lg sm:col-span-4">Nouvelle offre</h2>
    <label class="block sm:col-span-3"><span class="label">Intitulé du poste</span><input name="title" required maxlength="120" class="input !py-2" placeholder="Ex. : Commercial B2B terrain" /></label>
    <label class="block"><span class="label">Ordre</span><input name="position" value={jobs.length + 1} inputmode="numeric" class="input !py-2" /></label>
    <label class="block sm:col-span-2"><span class="label">Lieu</span><input name="place" maxlength="80" class="input !py-2" placeholder="Ex. : Lomé" /></label>
    <label class="block sm:col-span-2"><span class="label">Contrat</span><input name="contract" maxlength="60" class="input !py-2" placeholder="Ex. : CDI, CDD 6 mois, stage" /></label>
    <label class="block sm:col-span-4"><span class="label">Description</span><textarea name="text" rows="3" maxlength="1000" class="input"></textarea></label>
    <label class="flex items-end gap-2 pb-2 text-sm"><input type="checkbox" name="published" checked />Publiée</label>
    <div class="flex items-end sm:col-span-3"><button name="action" value="create" class="btn btn-primary btn-sm">Ajouter l'offre</button></div>
  </form>
</AdminLayout>

<script>
  import { initAdminForms } from '../../scripts/admin';
  initAdminForms();
</script>

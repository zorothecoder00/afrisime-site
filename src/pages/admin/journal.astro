---
// Journal d'activité (§10) : traçabilité des actions sensibles (connexions, rôles, commandes,
// publications, suppressions, exports…).
import { alias } from 'drizzle-orm/pg-core';
import { and, count, desc, eq, ilike, type SQL } from 'drizzle-orm';
import AdminLayout from '../../components/AdminLayout.astro';
import Pagination from '../../components/admin/Pagination.astro';
import { auditLog, user } from '../../db/schema';
import { deny } from '../../lib/admin';
import { db } from '../../lib/db';
import { formatDateTime } from '../../lib/format';

const denied = deny(Astro.locals.user, { audit: ['read'] });
if (denied) return denied;

const PAGE_SIZE = 50;
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const action = Astro.url.searchParams.get('action') ?? '';
const actor = alias(user, 'actor');
const where: SQL[] = [];
if (action) where.push(ilike(auditLog.action, `%${action.replace(/[%_\\]/g, '\\$&')}%`));
const condition = where.length ? and(...where) : undefined;
const [rows, [{ total }]] = await Promise.all([
  db
    .select({ entry: auditLog, actorName: actor.name, actorEmail: actor.email })
    .from(auditLog)
    .leftJoin(actor, eq(actor.id, auditLog.actorId))
    .where(condition)
    .orderBy(desc(auditLog.createdAt))
    .limit(PAGE_SIZE)
    .offset((page - 1) * PAGE_SIZE),
  db.select({ total: count() }).from(auditLog).where(condition),
]);
---

<AdminLayout title="Journal d'activité">
  <form method="get" class="flex gap-2">
    <input name="action" value={action} class="input !w-auto !py-2" placeholder="Action (ex. role, commande, connexion)" aria-label="Filtrer par action" />
    <button class="btn btn-secondary btn-sm">Filtrer</button>
  </form>
  <div class="card mt-4 overflow-x-auto">
    <table class="w-full min-w-[720px] text-left text-sm">
      <thead class="border-b border-line bg-canvas text-muted">
        <tr><th class="px-4 py-2">Date</th><th class="px-4 py-2">Qui</th><th class="px-4 py-2">Action</th><th class="px-4 py-2">Cible</th><th class="px-4 py-2">Détails</th><th class="px-4 py-2">IP</th></tr>
      </thead>
      <tbody class="divide-y divide-line">
        {
          rows.map(({ entry, actorName, actorEmail }) => (
            <tr>
              <td class="whitespace-nowrap px-4 py-2">{formatDateTime(entry.createdAt)}</td>
              <td class="px-4 py-2">{actorName ?? 'Système'}{actorEmail && <span class="block text-xs text-muted">{actorEmail}</span>}</td>
              <td class="px-4 py-2 font-semibold">{entry.action}</td>
              <td class="px-4 py-2 font-mono text-xs">{entry.target}</td>
              <td class="px-4 py-2 font-mono text-xs">{entry.details ? JSON.stringify(entry.details) : ''}</td>
              <td class="px-4 py-2 text-xs text-muted">{entry.ipAddress}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <Pagination total={total} page={page} pageSize={PAGE_SIZE} />
</AdminLayout>

---
// Programmes et projets de la page publique Programmes & Projets : ajout, modification,
// publication, suppression. Mêmes opérations en JSON : /api/admin/programmes.
import AdminLayout from '../../components/AdminLayout.astro';
import ProjectFields from '../../components/admin/ProjectFields.astro';
import { cardTint } from '../../lib/tints';
import { bool, deny, str } from '../../lib/admin';
import { audit } from '../../lib/audit';
import { storeUpload, UploadError } from '../../lib/media';
import {
  createProject,
  deleteProject,
  getProject,
  listProjects,
  parseProjectFields,
  PROJECT_KINDS,
  PROJECT_STATUSES,
  updateProject,
} from '../../lib/projects';

const me = Astro.locals.user!;
const denied = deny(me, { content: ['update'] });
if (denied) return denied;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = str(form, 'action');
  let id = str(form, 'id', 80);
  if (action === 'delete') {
    await deleteProject(id, me.id);
  } else {
    const fields = ['kind', 'title', 'summary', 'text', 'status', 'place', 'period', 'position'];
    const parsed = parseProjectFields({ ...Object.fromEntries(fields.map((f) => [f, str(form, f, 4000)])), published: bool(form, 'published') });
    const values = parsed.values;
    error = parsed.error ?? '';
    const current = action === 'update' ? await getProject(id) : null;
    if (!error && action === 'update' && !current) error = 'Ce programme ou projet n’existe plus.';
    if (!error) {
      values.imageId = bool(form, 'removeImage') ? '' : (current?.imageId ?? '');
      const image = form.get('image');
      if (image && typeof image !== 'string' && image.size > 0) {
        try {
          values.imageId = (await storeUpload(image, { uploadedBy: me.id, alt: values.title ?? '' })).id;
        } catch (err) {
          error = err instanceof UploadError ? err.message : "L'image n'a pas pu être enregistrée.";
        }
      }
    }
    if (!error) {
      if (action === 'create') id = (await createProject(values, me.id)).id;
      else await updateProject(id, values, me.id);
    }
  }
  if (!error) {
    await audit({ actorId: me.id, action: `programme-${action}`, target: id || undefined, ipAddress: Astro.clientAddress });
    return Astro.redirect('/admin/programmes?ok=1', 303);
  }
}

const projects = await listProjects();
---

<AdminLayout title="Programmes & projets">
  {Astro.url.searchParams.has('ok') && <p class="alert alert-success mb-4">Programmes et projets mis à jour. Visibles sur le site d'ici une minute.</p>}
  {error && <p class="alert alert-error mb-4" role="alert">{error}</p>}

  <p class="hint mb-4">
    Affichés sur la page <a href="/programmes" target="_blank" class="font-semibold underline">Programmes & Projets ↗</a>, regroupés par type puis dans l'ordre indiqué.
  </p>

  <div class="mb-8 space-y-2">
    {projects.length === 0 && <p class:list={['card p-4 text-muted', cardTint(0)]}>Aucun programme ni projet pour le moment.</p>}
    {
      projects.map((p) => (
        <details class:list={['card p-4', cardTint(1)]}>
          <summary class="cursor-pointer font-semibold">
            {p.position}. {p.title}{' '}
            <span class="font-normal text-muted">· {[PROJECT_KINDS[p.kind], PROJECT_STATUSES[p.status], p.place, p.period].filter(Boolean).join(' · ')}</span>
            {!p.published && <span class="badge badge-rupture ml-2">Masqué</span>}
          </summary>
          <form method="post" enctype="multipart/form-data" class="mt-3 grid gap-3 sm:grid-cols-4">
            <input type="hidden" name="id" value={p.id} />
            <ProjectFields p={p} />
            <div class="flex items-end gap-2 sm:col-span-3">
              <button name="action" value="update" class="btn btn-primary btn-sm">Enregistrer</button>
              <button name="action" value="delete" formnovalidate class="btn btn-ghost btn-sm text-danger" data-confirm="Supprimer ce programme ou projet ?">Supprimer</button>
            </div>
          </form>
        </details>
      ))
    }
  </div>

  <form method="post" enctype="multipart/form-data" class:list={['card grid gap-3 p-5 sm:grid-cols-4', cardTint(2)]}>
    <h2 class="text-lg sm:col-span-4">Nouveau programme ou projet</h2>
    <ProjectFields position={projects.length + 1} />
    <div class="flex items-end sm:col-span-3"><button name="action" value="create" class="btn btn-primary btn-sm">Ajouter</button></div>
  </form>
</AdminLayout>

<script>
  import { initAdminForms } from '../../scripts/admin';
  initAdminForms();
</script>

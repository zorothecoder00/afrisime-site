---
// Catalogue › Catégories : création, modification, ordre d'affichage, suppression (si vide).
import { count, eq } from 'drizzle-orm';
import AdminLayout from '../../../components/AdminLayout.astro';
import Tabs from '../../../components/admin/Tabs.astro';
import { categories, products } from '../../../db/schema';
import { deny, int, isSlug, optionalStr, slugify, str } from '../../../lib/admin';
import { audit } from '../../../lib/audit';
import { invalidateCatalog } from '../../../lib/catalog';
import { db } from '../../../lib/db';
import { imageUrl, storeUpload, UploadError } from '../../../lib/media';
import { can } from '../../../lib/roles';

const me = Astro.locals.user!;
const denied = deny(me, { catalog: ['read'] });
if (denied) return denied;
const canEdit = can(me.role, { catalog: ['update'] });
const ICONS = ['basket', 'bottle', 'grain', 'drop', 'leaf', 'sparkle', 'box', 'store', 'chef', 'globe', 'star'];
let error = '';

if (Astro.request.method === 'POST') {
  if (!canEdit) return new Response('Accès refusé.', { status: 403 });
  const form = await Astro.request.formData();
  const action = str(form, 'action');
  const id = str(form, 'id', 80);

  if (action === 'delete') {
    const [{ total }] = await db.select({ total: count() }).from(products).where(eq(products.categoryId, id));
    if (total > 0) error = `Impossible : ${total} produit(s) utilisent encore cette catégorie.`;
    else {
      await db.delete(categories).where(eq(categories.id, id));
      await audit({ actorId: me.id, action: 'categorie-supprimee', target: id, ipAddress: Astro.clientAddress });
    }
  } else {
    const name = str(form, 'name', 80);
    const color = /^#[0-9a-f]{6}$/i.test(str(form, 'color')) ? str(form, 'color') : '#2e7d5b';
    const values = {
      name,
      description: str(form, 'description', 300),
      icon: ICONS.includes(str(form, 'icon')) ? str(form, 'icon') : 'basket',
      color,
      position: int(form, 'position') ?? 0,
      seoTitle: optionalStr(form, 'seoTitle', 70),
      seoDescription: optionalStr(form, 'seoDescription', 170),
    } as Record<string, unknown>;
    const image = form.get('image');
    if (image && typeof image !== 'string' && image.size > 0) {
      try {
        values.imageId = (await storeUpload(image, { uploadedBy: me.id, alt: name })).id;
      } catch (err) {
        error = err instanceof UploadError ? err.message : "L'image n'a pas pu être enregistrée.";
      }
    }
    if (name.length < 2) error = 'Nom obligatoire.';
    if (!error && action === 'create') {
      const newId = str(form, 'newId', 80) || slugify(name);
      if (!isSlug(newId)) error = 'Identifiant invalide (minuscules, chiffres, tirets).';
      else {
        const inserted = await db.insert(categories).values({ id: newId, ...(values as { name: string }) }).onConflictDoNothing().returning({ id: categories.id });
        if (!inserted.length) error = 'Cet identifiant existe déjà.';
        else await audit({ actorId: me.id, action: 'categorie-creee', target: newId, ipAddress: Astro.clientAddress });
      }
    } else if (!error && action === 'update') {
      await db.update(categories).set(values).where(eq(categories.id, id));
      await audit({ actorId: me.id, action: 'categorie-modifiee', target: id, ipAddress: Astro.clientAddress });
    }
  }
  if (!error) {
    invalidateCatalog();
    return Astro.redirect('/admin/catalogue/categories?ok=1', 303);
  }
}

const list = await db
  .select({ category: categories, products: count(products.id) })
  .from(categories)
  .leftJoin(products, eq(products.categoryId, categories.id))
  .groupBy(categories.id)
  .orderBy(categories.position, categories.name);
---

<AdminLayout title="Catalogue">
  <Tabs items={[{ label: 'Produits', href: '/admin/catalogue' }, { label: 'Catégories', href: '/admin/catalogue/categories' }, { label: 'Marques', href: '/admin/catalogue/marques' }]} />
  {Astro.url.searchParams.has('ok') && <p class="alert alert-success mb-4">Enregistré.</p>}
  {error && <p class="alert alert-error mb-4" role="alert">{error}</p>}

  <div class="space-y-3">
    {
      list.map(({ category: c, products: n }) => (
        <details class="card p-4">
          <summary class="flex cursor-pointer list-none flex-wrap items-center gap-3">
            <span class="grid size-9 place-items-center rounded-lg text-xs font-bold" style={`background:${c.color}22;color:${c.color}`}>{c.position}</span>
            <span class="flex-1 font-semibold">{c.name} <span class="font-normal text-muted">· {c.id} · {n} produit{n > 1 ? 's' : ''}</span></span>
            {c.imageId && <img src={imageUrl(c.imageId, 'mini')} alt="" class="size-9 rounded object-cover" />}
          </summary>
          <form method="post" enctype="multipart/form-data" class="mt-4 grid gap-3 sm:grid-cols-4">
            <fieldset disabled={!canEdit} class="contents">
              <input type="hidden" name="id" value={c.id} />
              <label class="block sm:col-span-2"><span class="label">Nom</span><input name="name" value={c.name} required class="input !py-2" /></label>
              <label class="block"><span class="label">Ordre</span><input name="position" value={c.position} inputmode="numeric" class="input !py-2" /></label>
              <label class="block"><span class="label">Couleur</span><input type="color" name="color" value={c.color} class="h-10 w-full rounded-lg border border-line" /></label>
              <label class="block sm:col-span-3"><span class="label">Description</span><input name="description" value={c.description} class="input !py-2" /></label>
              <label class="block">
                <span class="label">Icône</span>
                <select name="icon" class="input !py-2">{ICONS.map((i) => <option selected={i === c.icon}>{i}</option>)}</select>
              </label>
              <label class="block sm:col-span-2"><span class="label">Titre SEO</span><input name="seoTitle" value={c.seoTitle ?? ''} maxlength="70" class="input !py-2" /></label>
              <label class="block sm:col-span-2"><span class="label">Méta-description</span><input name="seoDescription" value={c.seoDescription ?? ''} maxlength="170" class="input !py-2" /></label>
              <label class="block sm:col-span-2"><span class="label">Image</span><input type="file" name="image" accept="image/*" class="input !py-1.5" /></label>
              <div class="flex items-end gap-2 sm:col-span-2">
                <button name="action" value="update" class="btn btn-primary btn-sm">Enregistrer</button>
                <button name="action" value="delete" class="btn btn-ghost btn-sm text-danger" data-confirm="Supprimer cette catégorie ?" formnovalidate>Supprimer</button>
              </div>
            </fieldset>
          </form>
        </details>
      ))
    }
  </div>

  {
    canEdit && (
      <form method="post" enctype="multipart/form-data" class="card mt-8 grid gap-3 p-5 sm:grid-cols-4">
        <h2 class="text-lg sm:col-span-4">Nouvelle catégorie</h2>
        <label class="block sm:col-span-2"><span class="label">Nom</span><input name="name" required class="input !py-2" data-slug-source /></label>
        <label class="block"><span class="label">Identifiant (URL)</span><input name="newId" class="input !py-2" data-slug-target /></label>
        <label class="block"><span class="label">Ordre</span><input name="position" value={list.length + 1} inputmode="numeric" class="input !py-2" /></label>
        <label class="block sm:col-span-2"><span class="label">Description</span><input name="description" class="input !py-2" /></label>
        <label class="block"><span class="label">Icône</span><select name="icon" class="input !py-2">{ICONS.map((i) => <option>{i}</option>)}</select></label>
        <label class="block"><span class="label">Couleur</span><input type="color" name="color" value="#2e7d5b" class="h-10 w-full rounded-lg border border-line" /></label>
        <div class="sm:col-span-4"><button name="action" value="create" class="btn btn-primary btn-sm">Créer la catégorie</button></div>
      </form>
    )
  }
</AdminLayout>

<script>
  import { initAdminForms } from '../../../scripts/admin';
  initAdminForms();
</script>

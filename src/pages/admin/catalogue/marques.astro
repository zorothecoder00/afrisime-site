---
// Catalogue › Marques : création, modification, logo, suppression (si aucun produit).
import { count, eq } from 'drizzle-orm';
import AdminLayout from '../../../components/AdminLayout.astro';
import Tabs from '../../../components/admin/Tabs.astro';
import { brands, products } from '../../../db/schema';
import { deny, int, isSlug, optionalStr, slugify, str } from '../../../lib/admin';
import { audit } from '../../../lib/audit';
import { invalidateCatalog } from '../../../lib/catalog';
import { db } from '../../../lib/db';
import { imageUrl, storeUpload, UploadError } from '../../../lib/media';
import { can } from '../../../lib/roles';

const me = Astro.locals.user!;
const denied = deny(me, { catalog: ['read'] });
if (denied) return denied;
const canEdit = can(me.role, { catalog: ['update'] });
let error = '';

if (Astro.request.method === 'POST') {
  if (!canEdit) return new Response('Accès refusé.', { status: 403 });
  const form = await Astro.request.formData();
  const action = str(form, 'action');
  const id = str(form, 'id', 80);

  if (action === 'delete') {
    const [{ total }] = await db.select({ total: count() }).from(products).where(eq(products.brandId, id));
    if (total > 0) error = `Impossible : ${total} produit(s) utilisent encore cette marque.`;
    else {
      await db.delete(brands).where(eq(brands.id, id));
      await audit({ actorId: me.id, action: 'marque-supprimee', target: id, ipAddress: Astro.clientAddress });
    }
  } else {
    const name = str(form, 'name', 80);
    const values: Record<string, unknown> = {
      name,
      description: str(form, 'description', 300),
      position: int(form, 'position') ?? 0,
      seoTitle: optionalStr(form, 'seoTitle', 70),
      seoDescription: optionalStr(form, 'seoDescription', 170),
    };
    const logo = form.get('logo');
    if (logo && typeof logo !== 'string' && logo.size > 0) {
      try {
        values.logoId = (await storeUpload(logo, { uploadedBy: me.id, alt: name })).id;
      } catch (err) {
        error = err instanceof UploadError ? err.message : "Le logo n'a pas pu être enregistré.";
      }
    }
    if (name.length < 2) error = 'Nom obligatoire.';
    if (!error && action === 'create') {
      const newId = str(form, 'newId', 80) || slugify(name);
      if (!isSlug(newId)) error = 'Identifiant invalide (minuscules, chiffres, tirets).';
      else {
        const inserted = await db.insert(brands).values({ id: newId, ...(values as { name: string }) }).onConflictDoNothing().returning({ id: brands.id });
        if (!inserted.length) error = 'Cet identifiant existe déjà.';
        else await audit({ actorId: me.id, action: 'marque-creee', target: newId, ipAddress: Astro.clientAddress });
      }
    } else if (!error && action === 'update') {
      await db.update(brands).set(values).where(eq(brands.id, id));
      await audit({ actorId: me.id, action: 'marque-modifiee', target: id, ipAddress: Astro.clientAddress });
    }
  }
  if (!error) {
    invalidateCatalog();
    return Astro.redirect('/admin/catalogue/marques?ok=1', 303);
  }
}

const list = await db
  .select({ brand: brands, products: count(products.id) })
  .from(brands)
  .leftJoin(products, eq(products.brandId, brands.id))
  .groupBy(brands.id)
  .orderBy(brands.position, brands.name);
---

<AdminLayout title="Catalogue">
  <Tabs items={[{ label: 'Produits', href: '/admin/catalogue' }, { label: 'Catégories', href: '/admin/catalogue/categories' }, { label: 'Marques', href: '/admin/catalogue/marques' }]} />
  {Astro.url.searchParams.has('ok') && <p class="alert alert-success mb-4">Enregistré.</p>}
  {error && <p class="alert alert-error mb-4" role="alert">{error}</p>}

  <div class="space-y-3">
    {
      list.map(({ brand: b, products: n }) => (
        <details class="card p-4">
          <summary class="flex cursor-pointer list-none items-center gap-3">
            {b.logoId ? <img src={imageUrl(b.logoId, 'mini')} alt="" class="h-9 w-16 object-contain" /> : <span class="grid h-9 w-16 place-items-center rounded bg-canvas text-xs text-muted">logo</span>}
            <span class="flex-1 font-semibold">{b.name} <span class="font-normal text-muted">· {b.id} · {n} produit{n > 1 ? 's' : ''}</span></span>
          </summary>
          <form method="post" enctype="multipart/form-data" class="mt-4 grid gap-3 sm:grid-cols-4">
            <fieldset disabled={!canEdit} class="contents">
              <input type="hidden" name="id" value={b.id} />
              <label class="block sm:col-span-2"><span class="label">Nom</span><input name="name" value={b.name} required class="input !py-2" /></label>
              <label class="block"><span class="label">Ordre</span><input name="position" value={b.position} inputmode="numeric" class="input !py-2" /></label>
              <label class="block"><span class="label">Logo</span><input type="file" name="logo" accept="image/*" class="input !py-1.5" /></label>
              <label class="block sm:col-span-4"><span class="label">Description</span><input name="description" value={b.description} class="input !py-2" /></label>
              <label class="block sm:col-span-2"><span class="label">Titre SEO</span><input name="seoTitle" value={b.seoTitle ?? ''} maxlength="70" class="input !py-2" /></label>
              <label class="block sm:col-span-2"><span class="label">Méta-description</span><input name="seoDescription" value={b.seoDescription ?? ''} maxlength="170" class="input !py-2" /></label>
              <div class="flex gap-2 sm:col-span-4">
                <button name="action" value="update" class="btn btn-primary btn-sm">Enregistrer</button>
                <button name="action" value="delete" class="btn btn-ghost btn-sm text-danger" data-confirm="Supprimer cette marque ?" formnovalidate>Supprimer</button>
              </div>
            </fieldset>
          </form>
        </details>
      ))
    }
  </div>

  {
    canEdit && (
      <form method="post" enctype="multipart/form-data" class="card mt-8 grid gap-3 p-5 sm:grid-cols-4">
        <h2 class="text-lg sm:col-span-4">Nouvelle marque</h2>
        <label class="block sm:col-span-2"><span class="label">Nom</span><input name="name" required class="input !py-2" data-slug-source /></label>
        <label class="block"><span class="label">Identifiant (URL)</span><input name="newId" class="input !py-2" data-slug-target /></label>
        <label class="block"><span class="label">Logo</span><input type="file" name="logo" accept="image/*" class="input !py-1.5" /></label>
        <label class="block sm:col-span-4"><span class="label">Description</span><input name="description" class="input !py-2" /></label>
        <div class="sm:col-span-4"><button name="action" value="create" class="btn btn-primary btn-sm">Créer la marque</button></div>
      </form>
    )
  }
</AdminLayout>

<script>
  import { initAdminForms } from '../../../scripts/admin';
  initAdminForms();
</script>

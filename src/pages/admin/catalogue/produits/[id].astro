---
// Catalogue › fiche produit : création (/nouveau) et modification.
import { eq } from 'drizzle-orm';
import AdminLayout from '../../../../components/AdminLayout.astro';
import { products } from '../../../../db/schema';
import { deny, str } from '../../../../lib/admin';
import { audit } from '../../../../lib/audit';
import { getCatalog, invalidateCatalog } from '../../../../lib/catalog';
import { keptImages, parseProductForm, PRODUCT_BADGES } from '../../../../lib/catalog-admin';
import { db } from '../../../../lib/db';
import { BADGE_LABELS, STATUS_LABELS } from '../../../../lib/format';
import { imageUrl, storeUpload, UploadError } from '../../../../lib/media';
import { addRedirect } from '../../../../lib/redirects';
import { can } from '../../../../lib/roles';

const me = Astro.locals.user!;
const denied = deny(me, { catalog: ['read'] });
if (denied) return denied;
const canEdit = can(me.role, { catalog: ['update'] });

const isNew = Astro.params.id === 'nouveau';
let row: typeof products.$inferSelect | undefined = isNew ? undefined : (await db.select().from(products).where(eq(products.id, Astro.params.id!)).limit(1))[0];
if (!isNew && !row) return new Response(null, { status: 404 });

let errors: Record<string, string> = {};
let draft: Partial<typeof products.$inferSelect> = row ?? { status: 'disponible', published: true, variants: [], features: [], badges: [], related: [], imageIds: [], origin: 'importe', popularity: 0 };

if (Astro.request.method === 'POST') {
  if (!canEdit) return new Response('Accès refusé.', { status: 403 });
  const form = await Astro.request.formData();

  if (str(form, 'action') === 'delete' && row) {
    await db.delete(products).where(eq(products.id, row.id));
    await addRedirect(`/boutique/${row.slug}`, '/boutique');
    await audit({ actorId: me.id, action: 'produit-supprime', target: row.id, details: { sku: row.sku }, ipAddress: Astro.clientAddress });
    invalidateCatalog();
    return Astro.redirect('/admin/catalogue?ok=supprime', 303);
  }

  const parsed = parseProductForm(form);
  errors = parsed.errors;
  const imageIds = row ? keptImages(form, row.imageIds) : [];
  // Nouvelles photos : compressées en WebP, ajoutées à la suite.
  const alt = str(form, 'newImagesAlt', 300) || parsed.values.name;
  for (const file of form.getAll('newImages')) {
    if (typeof file === 'string' || file.size === 0) continue;
    try {
      imageIds.push((await storeUpload(file, { uploadedBy: me.id, alt })).id);
    } catch (err) {
      errors.images = err instanceof UploadError ? err.message : "Une photo n'a pas pu être enregistrée.";
    }
  }
  draft = { ...draft, ...parsed.values, imageIds };

  if (!Object.keys(errors).length) {
    try {
      if (row) {
        await db.update(products).set({ ...parsed.values, imageIds }).where(eq(products.id, row.id));
        if (row.slug !== parsed.values.slug) await addRedirect(`/boutique/${row.slug}`, `/boutique/${parsed.values.slug}`);
        await audit({ actorId: me.id, action: 'produit-modifie', target: row.id, ipAddress: Astro.clientAddress });
      } else {
        const id = parsed.values.slug;
        await db.insert(products).values({ ...parsed.values, id, imageIds });
        await audit({ actorId: me.id, action: 'produit-cree', target: id, ipAddress: Astro.clientAddress });
        row = { id } as typeof products.$inferSelect;
      }
      invalidateCatalog();
      return Astro.redirect(`/admin/catalogue/produits/${row!.id}?ok=1`, 303);
    } catch (err) {
      const message = String((err as { cause?: { detail?: string } }).cause?.detail ?? (err as Error).message);
      errors.form = message.includes('sku') ? 'Cette référence (SKU) existe déjà.' : message.includes('slug') || message.includes('pkey') ? 'Cette adresse est déjà utilisée par un autre produit.' : "L'enregistrement a échoué.";
      console.error(err);
    }
  }
}

const { products: all, categories, brands } = await getCatalog({ includeUnpublished: true });
const imageMeta = new Map(all.flatMap((p) => p.data.images).map((i) => [i.id, i]));
const variants = draft.variants?.length ? draft.variants : [{ id: '', label: '', price: 0, unit: 'unité', weightKg: 0 }];
const features = [...(draft.features ?? []), { label: '', value: '' }];
const ok = Astro.url.searchParams.has('ok');
const title = isNew ? 'Nouveau produit' : (row?.name ?? 'Produit');
---

<AdminLayout title={title} back={{ label: 'Catalogue', href: '/admin/catalogue' }}>
  {ok && <p class="alert alert-success mb-4">Produit enregistré. Il est visible sur le site d'ici une minute. {row && draft.published && <a href={`/boutique/${draft.slug}`} class="font-bold underline" target="_blank">Voir la fiche</a>}</p>}
  {Object.keys(errors).length > 0 && <div class="alert alert-error mb-4" role="alert"><p class="font-bold">Enregistrement impossible :</p><ul class="mt-1 list-disc pl-5">{Object.values(errors).map((e) => <li>{e}</li>)}</ul></div>}

  <form method="post" enctype="multipart/form-data" class="grid gap-6 lg:grid-cols-[1fr_340px]" data-product-editor>
    <fieldset disabled={!canEdit} class="contents">
      <div class="space-y-6">
        <section class="card grid gap-4 p-5 sm:grid-cols-2">
          <h2 class="text-lg sm:col-span-2">Identité</h2>
          <label class="block sm:col-span-2"><span class="label">Nom</span><input name="name" required maxlength="160" class="input" value={draft.name} data-slug-source /></label>
          <label class="block"><span class="label">Référence (SKU)</span><input name="sku" required maxlength="40" class="input uppercase" value={draft.sku} /></label>
          <label class="block">
            <span class="label">Adresse de la page</span>
            <span class="flex items-center gap-1 text-sm text-muted">/boutique/<input name="slug" maxlength="80" class="input !py-2" value={draft.slug} data-slug-target={isNew ? '' : undefined} /></span>
            {!isNew && <span class="hint block">Si vous la changez, l'ancienne adresse redirige automatiquement vers la nouvelle.</span>}
          </label>
          <label class="block">
            <span class="label">Catégorie</span>
            <select name="categoryId" required class="input">
              <option value="">Choisir…</option>
              {categories.map((c) => <option value={c.id} selected={c.id === draft.categoryId}>{c.data.name}</option>)}
            </select>
          </label>
          <label class="block">
            <span class="label">Marque</span>
            <select name="brandId" required class="input">
              <option value="">Choisir…</option>
              {brands.map((b) => <option value={b.id} selected={b.id === draft.brandId}>{b.data.name}</option>)}
            </select>
          </label>
          <label class="block sm:col-span-2"><span class="label">Résumé</span><input name="summary" maxlength="300" class="input" value={draft.summary} /></label>
          <label class="block sm:col-span-2"><span class="label">Description détaillée</span><textarea name="description" rows="6" maxlength="5000" class="input">{draft.description}</textarea><span class="hint block">Laissez une ligne vide entre deux paragraphes.</span></label>
          <fieldset class="sm:col-span-2">
            <legend class="label">Origine</legend>
            <div class="flex gap-4 text-sm">
              <label class="flex items-center gap-2"><input type="radio" name="origin" value="importe" checked={draft.origin !== 'local'} />Importé</label>
              <label class="flex items-center gap-2"><input type="radio" name="origin" value="local" checked={draft.origin === 'local'} />Produit local</label>
            </div>
          </fieldset>
        </section>

        <section class="card p-5">
          <h2 class="text-lg">Formats et prix (FCFA)</h2>
          <p class="hint">Prix barré : ancien prix affiché barré (promotion). Prix pro : réservé aux comptes professionnels validés.</p>
          <div class="mt-3 overflow-x-auto">
            <table class="w-full min-w-[760px] text-sm">
              <thead class="text-left text-muted">
                <tr><th class="p-1">Libellé</th><th class="p-1">Identifiant</th><th class="p-1">Prix</th><th class="p-1">Prix barré</th><th class="p-1">Prix pro</th><th class="p-1">Unité</th><th class="p-1">Poids (kg)</th><th></th></tr>
              </thead>
              <tbody data-rows="variants">
                {variants.map((v, i) => (
                  <tr data-row>
                    <td class="p-1"><input name={`variants[${i}][label]`} value={v.label} class="input !py-2" placeholder="Sac 25 kg" /></td>
                    <td class="p-1"><input name={`variants[${i}][id]`} value={v.id} class="input !py-2" placeholder="25kg" /></td>
                    <td class="p-1"><input name={`variants[${i}][price]`} value={v.price || ''} inputmode="numeric" class="input !py-2" /></td>
                    <td class="p-1"><input name={`variants[${i}][compareAtPrice]`} value={v.compareAtPrice ?? ''} inputmode="numeric" class="input !py-2" /></td>
                    <td class="p-1"><input name={`variants[${i}][proPrice]`} value={v.proPrice ?? ''} inputmode="numeric" class="input !py-2" /></td>
                    <td class="p-1"><input name={`variants[${i}][unit]`} value={v.unit} class="input !py-2" placeholder="sac" /></td>
                    <td class="p-1"><input name={`variants[${i}][weightKg]`} value={v.weightKg || ''} inputmode="decimal" class="input !py-2" /></td>
                    <td class="p-1"><button type="button" class="btn btn-ghost btn-sm text-danger" data-remove-row aria-label="Retirer ce format">✕</button></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <button type="button" class="btn btn-secondary btn-sm mt-3" data-add-row="variants">+ Ajouter un format</button>
        </section>

        <section class="card p-5">
          <h2 class="text-lg">Caractéristiques</h2>
          <div class="mt-3 space-y-2" data-rows="features">
            {features.map((f, i) => (
              <div class="grid grid-cols-[1fr_2fr_auto] gap-2" data-row>
                <input name={`features[${i}][label]`} value={f.label} class="input !py-2" placeholder="Conservation" />
                <input name={`features[${i}][value]`} value={f.value} class="input !py-2" placeholder="Au sec, à l'abri de la chaleur" />
                <button type="button" class="btn btn-ghost btn-sm text-danger" data-remove-row aria-label="Retirer">✕</button>
              </div>
            ))}
          </div>
          <button type="button" class="btn btn-secondary btn-sm mt-3" data-add-row="features">+ Ajouter une caractéristique</button>
        </section>

        <section class="card p-5">
          <h2 class="text-lg">Photos</h2>
          {errors.images && <p class="field-error">{errors.images}</p>}
          {
            (draft.imageIds ?? []).length > 0 && (
              <ul class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
                {(draft.imageIds ?? []).map((id, i) => (
                  <li class="card p-2 text-xs">
                    <img src={imageUrl(id, 'mini')} alt={imageMeta.get(id)?.alt ?? ''} class="aspect-square w-full rounded-lg bg-white object-contain" loading="lazy" />
                    <input type="hidden" name={`images[${i}][id]`} value={id} />
                    <label class="mt-2 flex items-center justify-between gap-2">Ordre <input name={`images[${i}][position]`} value={i + 1} inputmode="numeric" class="input !w-14 !px-2 !py-1" /></label>
                    <label class="mt-1 flex items-center gap-2 text-danger"><input type="checkbox" name={`images[${i}][remove]`} />Retirer</label>
                  </li>
                ))}
              </ul>
            )
          }
          <label class="mt-4 block">
            <span class="label">Ajouter des photos</span>
            <input type="file" name="newImages" multiple accept="image/jpeg,image/png,image/webp,image/avif" class="input" />
            <span class="hint block">JPG, PNG ou WebP, 8 Mo max. Converties en WebP et redimensionnées automatiquement. La première photo est la photo principale.</span>
          </label>
          <label class="mt-3 block"><span class="label">Texte alternatif des nouvelles photos</span><input name="newImagesAlt" maxlength="300" class="input" placeholder="Ex. : Sac de riz parfumé 25 kg" /><span class="hint block">Décrit la photo pour les personnes malvoyantes et le référencement. Modifiable ensuite dans Médias.</span></label>
        </section>

        <section class="card grid gap-4 p-5">
          <h2 class="text-lg">Référencement (SEO)</h2>
          <label class="block"><span class="label">Titre de la page <span class="font-normal text-muted">(70 caractères max, sinon « Nom – Marque »)</span></span><input name="seoTitle" maxlength="70" class="input" value={draft.seoTitle ?? ''} /></label>
          <label class="block"><span class="label">Méta-description <span class="font-normal text-muted">(170 caractères max, sinon le résumé)</span></span><textarea name="seoDescription" maxlength="170" rows="2" class="input">{draft.seoDescription ?? ''}</textarea></label>
        </section>
      </div>

      <aside class="space-y-6">
        <section class="card space-y-4 p-5">
          <h2 class="text-lg">Publication</h2>
          <label class="flex items-center gap-2 text-sm font-semibold"><input type="checkbox" name="published" checked={draft.published} class="size-4 accent-brand-700" />Visible sur le site</label>
          <label class="block">
            <span class="label">Statut</span>
            <select name="status" class="input">
              {Object.entries(STATUS_LABELS).map(([id, label]) => <option value={id} selected={id === draft.status}>{label}</option>)}
            </select>
          </label>
          <label class="block"><span class="label">Stock <span class="font-normal text-muted">(facultatif, sinon ERP)</span></span><input name="stock" value={draft.stock ?? ''} inputmode="numeric" class="input" /></label>
          <label class="block"><span class="label">Délai indicatif</span><input name="leadTime" maxlength="80" value={draft.leadTime ?? ''} class="input" placeholder="Sous 24 h à Lomé" /></label>
          <label class="block"><span class="label">Popularité <span class="font-normal text-muted">(tri « populaires »)</span></span><input name="popularity" value={draft.popularity ?? 0} inputmode="numeric" class="input" /></label>
          <fieldset>
            <legend class="label">Badges</legend>
            <div class="flex flex-wrap gap-3 text-sm">
              {PRODUCT_BADGES.map((b) => <label class="flex items-center gap-1.5"><input type="checkbox" name="badges" value={b} checked={draft.badges?.includes(b)} />{BADGE_LABELS[b]}</label>)}
            </div>
          </fieldset>
          {canEdit && <button type="submit" name="action" value="save" class="btn btn-primary w-full">Enregistrer</button>}
        </section>

        <section class="card p-5">
          <h2 class="text-lg">Produits associés</h2>
          <p class="hint">Affichés sous « Vous aimerez aussi » (complétés par la même catégorie). Ctrl / Cmd pour en choisir plusieurs.</p>
          <select name="related" multiple size="10" class="input mt-2">
            {all.filter((p) => p.id !== row?.id).map((p) => <option value={p.id} selected={draft.related?.includes(p.id)}>{p.data.name}</option>)}
          </select>
        </section>

        {
          canEdit && row && !isNew && (
            <section class="card p-5">
              <h2 class="text-lg text-danger">Supprimer</h2>
              <p class="hint">Préférez « Visible sur le site » décoché pour retirer temporairement un produit.</p>
              <button type="submit" name="action" value="delete" formnovalidate class="btn btn-secondary btn-sm mt-3 !border-danger !text-danger" data-confirm="Supprimer définitivement ce produit ?">Supprimer le produit</button>
            </section>
          )
        }
      </aside>
    </fieldset>
  </form>
</AdminLayout>

<script>
  import { initAdminForms } from '../../../../scripts/admin';
  initAdminForms();
</script>

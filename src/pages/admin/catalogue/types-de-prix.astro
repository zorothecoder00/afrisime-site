---
// Catalogue › Types de prix : prix supplémentaires proposés à côté du prix normal
// (ex. prix à crédit). Les montants se saisissent dans chaque produit (Formats et prix).
import AdminLayout from '../../../components/AdminLayout.astro';
import CatalogTabs from '../../../components/admin/CatalogTabs.astro';
import { cardTint } from '../../../lib/tints';
import { bool, deny, int, str } from '../../../lib/admin';
import { audit } from '../../../lib/audit';
import { invalidateCatalog } from '../../../lib/catalog';
import { listPriceTypes, PRICE_AUDIENCES, priceTypeId, savePriceTypes, type PriceAudience, type PriceType } from '../../../lib/price-types';

const me = Astro.locals.user!;
const denied = deny(me, { catalog: ['update'] });
if (denied) return denied;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = str(form, 'action');
  const id = str(form, 'id', 40);
  const types = await listPriceTypes();
  if (action === 'delete') {
    await savePriceTypes(types.filter((t) => t.id !== id), me.id);
  } else {
    const audience = str(form, 'audience') as PriceAudience;
    const values = {
      label: str(form, 'label', 60),
      description: str(form, 'description', 400),
      audience: audience in PRICE_AUDIENCES ? audience : 'tous',
      validation: bool(form, 'validation'),
      position: int(form, 'position') ?? 0,
      active: bool(form, 'active'),
    };
    if (values.label.length < 3) error = 'Indiquez le nom du type de prix.';
    else if (action === 'create') {
      const newId = priceTypeId(values.label);
      if (!newId) error = 'Nom invalide.';
      else if (types.some((t) => t.id === newId)) error = 'Un type de prix porte déjà ce nom.';
      else await savePriceTypes([...types, { id: newId, ...values }], me.id);
    } else if (!types.some((t) => t.id === id)) error = 'Ce type de prix n’existe plus.';
    else await savePriceTypes(types.map((t): PriceType => (t.id === id ? { ...t, ...values } : t)), me.id);
  }
  if (!error) {
    invalidateCatalog();
    await audit({ actorId: me.id, action: `type-prix-${action}`, target: id || undefined, ipAddress: Astro.clientAddress });
    return Astro.redirect('/admin/catalogue/types-de-prix?ok=1', 303);
  }
}

const types = await listPriceTypes();
---

<AdminLayout title="Catalogue">
  <CatalogTabs />
  {Astro.url.searchParams.has('ok') && <p class="alert alert-success mb-4">Types de prix mis à jour. Visibles sur le site d'ici une minute.</p>}
  {error && <p class="alert alert-error mb-4" role="alert">{error}</p>}

  <div class:list={['card mb-6 space-y-2 p-4 text-sm', cardTint(3)]}>
    <p>
      Un <strong>type de prix</strong> s'ajoute au prix normal d'un produit (ex. <em>Prix à crédit</em>, <em>Prix de gros</em>). Le montant se saisit dans chaque produit,
      colonne du même nom du tableau <strong>Formats et prix</strong> ; un format sans montant n'est pas proposé à ce prix.
    </p>
    <p>
      Sur la fiche produit, le client voit les prix des types qui lui sont ouverts. À la commande, il choisit le type de prix si <strong>tous</strong> les articles de son panier en ont un ;
      le total est alors recalculé avec ces prix. Avec <strong>« Commande à valider »</strong>, il ne paie pas en ligne : la commande arrive en statut <em>À valider</em> et l'équipe le
      recontacte pour les conditions (dossier de crédit, échéancier…).
    </p>
  </div>

  <div class="mb-8 space-y-2">
    {types.length === 0 && <p class:list={['card p-4 text-muted', cardTint(0)]}>Aucun type de prix pour le moment : seuls le prix normal et le prix pro existent.</p>}
    {
      types.map((t) => (
        <details class:list={['card p-4', cardTint(1)]}>
          <summary class="cursor-pointer font-semibold">
            {t.position}. {t.label} <span class="font-normal text-muted">· {PRICE_AUDIENCES[t.audience]}{t.validation ? ' · commande à valider' : ''} · {t.id}</span>
            {!t.active && <span class="badge badge-rupture ml-2">Désactivé</span>}
          </summary>
          <form method="post" class="mt-3 grid gap-3 sm:grid-cols-4">
            <input type="hidden" name="id" value={t.id} />
            <label class="block sm:col-span-2"><span class="label">Nom</span><input name="label" value={t.label} required maxlength="60" class="input !py-2" /></label>
            <label class="block">
              <span class="label">Visible par</span>
              <select name="audience" class="input !py-2">
                {Object.entries(PRICE_AUDIENCES).map(([value, label]) => <option value={value} selected={value === t.audience}>{label}</option>)}
              </select>
            </label>
            <label class="block"><span class="label">Ordre</span><input name="position" value={t.position} inputmode="numeric" class="input !py-2" /></label>
            <label class="block sm:col-span-4">
              <span class="label">Conditions affichées au client</span>
              <textarea name="description" rows="2" maxlength="400" class="input">{t.description}</textarea>
            </label>
            <label class="flex items-center gap-2 text-sm sm:col-span-2"><input type="checkbox" name="validation" checked={t.validation} />Commande à valider par l'équipe (pas de paiement en ligne)</label>
            <label class="flex items-center gap-2 text-sm sm:col-span-2"><input type="checkbox" name="active" checked={t.active} />Actif</label>
            <div class="flex gap-2 sm:col-span-4">
              <button name="action" value="update" class="btn btn-primary btn-sm">Enregistrer</button>
              <button name="action" value="delete" formnovalidate class="btn btn-ghost btn-sm text-danger" data-confirm="Supprimer ce type de prix ? Les montants saisis dans les produits seront ignorés.">Supprimer</button>
            </div>
          </form>
        </details>
      ))
    }
  </div>

  <form method="post" class:list={['card grid gap-3 p-5 sm:grid-cols-4', cardTint(2)]}>
    <h2 class="text-lg sm:col-span-4">Nouveau type de prix</h2>
    <label class="block sm:col-span-2"><span class="label">Nom</span><input name="label" required maxlength="60" class="input !py-2" placeholder="Ex. : Prix à crédit" /></label>
    <label class="block">
      <span class="label">Visible par</span>
      <select name="audience" class="input !py-2">{Object.entries(PRICE_AUDIENCES).map(([value, label]) => <option value={value}>{label}</option>)}</select>
    </label>
    <label class="block"><span class="label">Ordre</span><input name="position" value={types.length + 1} inputmode="numeric" class="input !py-2" /></label>
    <label class="block sm:col-span-4">
      <span class="label">Conditions affichées au client</span>
      <textarea name="description" rows="2" maxlength="400" class="input" placeholder="Ex. : Paiement en 3 mensualités après étude de votre dossier. Un conseiller vous contacte sous 24 h."></textarea>
    </label>
    <label class="flex items-center gap-2 text-sm sm:col-span-2"><input type="checkbox" name="validation" />Commande à valider par l'équipe (pas de paiement en ligne)</label>
    <label class="flex items-center gap-2 text-sm sm:col-span-2"><input type="checkbox" name="active" checked />Actif</label>
    <div class="sm:col-span-4"><button name="action" value="create" class="btn btn-primary btn-sm">Ajouter le type de prix</button></div>
  </form>
</AdminLayout>

<script>
  import { initAdminForms } from '../../../scripts/admin';
  initAdminForms();
</script>

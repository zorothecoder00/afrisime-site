---
// Paramètres : identité et coordonnées (super administrateur), livraison et moyens de paiement
// (e-commerce manager), état des intégrations (lecture seule : réglées par variables d'environnement).
import AdminLayout from '../../components/AdminLayout.astro';
import { bool, int, isSlug, rows, safeHref, str } from '../../lib/admin';
import { audit } from '../../lib/audit';
import { emailConfigured } from '../../lib/notifications';
import { crmConfigured, erpConfigured } from '../../lib/integrations';
import { erpWebhookConfigured } from '../../lib/erp-auth';
import { getPaymentProvider } from '../../lib/payments/providers';
import { can } from '../../lib/roles';
import { getSettings, saveSettings } from '../../lib/settings';
import { isValidEmail } from '../../lib/validation';
import { imageUrl, storeUpload, storeVideo, UploadError, videoUrl } from '../../lib/media';
import { showcaseSource } from '../../lib/content';
import { media } from '../../db/schema';
import { db } from '../../lib/db';
import { and, eq, inArray } from 'drizzle-orm';
import type { DeliveryZone, PaymentMethod } from '../../data/site';
import { CRON_SECRET, NOTIFY_WEBHOOK_URL, STAFF_NOTIFY_EMAIL } from 'astro:env/server';

const me = Astro.locals.user!;
const canGlobal = can(me.role, { settings: ['update'] });
const canCommerce = can(me.role, { catalog: ['update'] });
// Mot du dirigeant : contenu de la page Qui sommes-nous, modifiable aussi par l'administrateur web.
const canWelcome = canGlobal || can(me.role, { content: ['publish'] });
if (!canGlobal && !canCommerce && !canWelcome) return new Response('Accès refusé.', { status: 403 });
const errors: string[] = [];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = str(form, 'action');

  if (action === 'identite') {
    if (!canGlobal) return new Response('Accès refusé.', { status: 403 });
    const email = str(form, 'email', 160);
    if (!isValidEmail(email)) errors.push('E-mail de contact invalide.');
    const social = rows(form, 'social')
      .filter((r) => r.label && r.href)
      .map((r) => ({ label: r.label.slice(0, 30), href: safeHref(r.href) ?? '' }));
    if (social.some((s) => !s.href)) errors.push('Lien de réseau social invalide (https://…).');
    if (!errors.length) {
      await saveSettings('identity', { name: str(form, 'name', 60) || 'AfriSime', tagline: str(form, 'tagline', 120), description: str(form, 'description', 300), topBar: str(form, 'topBar', 120) }, me.id);
      await saveSettings('contact', { phone: str(form, 'phone', 30), whatsapp: str(form, 'whatsapp', 20).replace(/\D/g, ''), email, address: str(form, 'address', 200), hours: str(form, 'hours', 100) }, me.id);
      await saveSettings('social', social, me.id);
    }
  }

  if (action === 'mot') {
    if (!canWelcome) return new Response('Accès refusé.', { status: 403 });
    const current = (await getSettings()).welcome;
    let photoId = bool(form, 'removePhoto') ? '' : current.photoId;
    const photo = form.get('photo');
    if (photo && typeof photo !== 'string' && photo.size > 0) {
      try {
        photoId = (await storeUpload(photo, { uploadedBy: me.id, alt: `Portrait de ${str(form, 'name', 120)}` })).id;
      } catch (err) {
        errors.push(err instanceof UploadError ? err.message : "La photo n'a pas pu être enregistrée.");
      }
    }
    const message = str(form, 'message', 4000);
    if (bool(form, 'enabled') && message.length < 20) errors.push('Le message est trop court.');
    if (!errors.length) {
      await saveSettings(
        'welcome',
        { enabled: bool(form, 'enabled'), title: str(form, 'title', 120), name: str(form, 'name', 120), role: str(form, 'role', 120), photoId, message },
        me.id,
      );
    }
  }

  if (action === 'vitrine') {
    if (!canWelcome) return new Response('Accès refusé.', { status: 403 });
    const current = (await getSettings()).showcase;
    const kept = rows(form, 'videos')
      .filter((r) => r.remove !== 'on')
      .map((r, i) => ({ title: (r.title ?? '').slice(0, 120), mediaId: r.mediaId ?? '', url: (r.url ?? '').slice(0, 500), position: Number(r.position) || i + 1 }))
      .sort((a, b) => a.position - b.position)
      .map(({ position: _, ...v }) => v);
    const newUrl = str(form, 'newUrl', 500);
    const newFile = form.get('newFile');
    const newTitle = str(form, 'newTitle', 120);
    if (newFile && typeof newFile !== 'string' && newFile.size > 0) {
      try {
        kept.push({ title: newTitle, mediaId: await storeVideo(newFile, me.id), url: '' });
      } catch (err) {
        errors.push(err instanceof UploadError ? err.message : "La vidéo n'a pas pu être enregistrée.");
      }
    } else if (newUrl) {
      if (!showcaseSource({ mediaId: '', url: newUrl })) errors.push('Lien non reconnu : collez un lien YouTube, Vimeo, ou l’adresse https d’un fichier MP4 / WebM.');
      else kept.push({ title: newTitle, mediaId: '', url: newUrl });
    }
    if (kept.some((v) => !v.mediaId && v.url && !showcaseSource(v))) errors.push('Un des liens n’est pas une vidéo YouTube, Vimeo ou MP4.');
    if (!errors.length) {
      await saveSettings('showcase', { enabled: bool(form, 'enabled'), videos: kept.slice(0, 8) }, me.id);
      // Les vidéos envoyées puis retirées sont supprimées de la base.
      const removed = current.videos.map((v) => v.mediaId).filter((id) => id && !kept.some((k) => k.mediaId === id));
      if (removed.length) await db.delete(media).where(and(inArray(media.id, removed), eq(media.kind, 'video')));
    }
  }

  if (action === 'livraison') {
    if (!canCommerce) return new Response('Accès refusé.', { status: 403 });
    const zones: DeliveryZone[] = rows(form, 'zones')
      .filter((r) => r.id && r.label)
      .map((r) => ({ id: r.id.slice(0, 40), label: r.label.slice(0, 120), fee: Math.max(0, Math.round(Number(r.fee) || 0)), delay: (r.delay ?? '').slice(0, 60), freeAbove: r.freeAbove === 'on', active: r.active === 'on' }));
    if (!zones.length) errors.push('Au moins une zone de livraison est nécessaire.');
    if (zones.some((z) => !isSlug(z.id))) errors.push('Identifiant de zone invalide (minuscules, chiffres, tirets).');
    if (new Set(zones.map((z) => z.id)).size !== zones.length) errors.push('Deux zones ont le même identifiant.');
    const current = await getSettings();
    const methods: PaymentMethod[] = current.payments.methods.map((m) => ({
      ...m,
      label: str(form, `pay-${m.id}-label`, 80) || m.label,
      description: str(form, `pay-${m.id}-description`, 160),
      enabled: bool(form, `pay-${m.id}-enabled`),
    }));
    if (!methods.some((m) => m.enabled)) errors.push('Au moins un moyen de paiement doit rester actif.');
    if (!errors.length) {
      await saveSettings('delivery', { zones, freeThreshold: int(form, 'freeThreshold') ?? 0 }, me.id);
      await saveSettings('payments', { methods }, me.id);
    }
  }

  if (!errors.length) {
    await audit({ actorId: me.id, action: `parametres-${action}`, ipAddress: Astro.clientAddress });
    return Astro.redirect(`/admin/parametres?ok=${action}`, 303);
  }
}

const s = await getSettings();
const provider = getPaymentProvider();
const integrations = [
  { label: 'Paiement en ligne', ok: !!provider, detail: provider ? provider.label : 'PAYMENT_PROVIDER + FEDAPAY_SECRET_KEY' },
  { label: 'E-mails', ok: emailConfigured(), detail: emailConfigured() ? 'Configuré' : 'EMAIL_PROVIDER + EMAIL_API_KEY + EMAIL_FROM' },
  { label: 'Alertes équipe par e-mail', ok: !!STAFF_NOTIFY_EMAIL, detail: STAFF_NOTIFY_EMAIL ?? 'STAFF_NOTIFY_EMAIL' },
  { label: 'SMS / WhatsApp', ok: !!NOTIFY_WEBHOOK_URL, detail: NOTIFY_WEBHOOK_URL ? 'Passerelle configurée' : 'NOTIFY_WEBHOOK_URL' },
  { label: 'ERP : envoi des commandes', ok: erpConfigured(), detail: 'ERP_API_URL + ERP_API_TOKEN' },
  { label: 'ERP : webhooks statut et catalogue', ok: erpWebhookConfigured(), detail: 'ERP_WEBHOOK_SECRET' },
  { label: 'CRM : envoi des leads', ok: crmConfigured(), detail: 'CRM_API_URL + CRM_API_TOKEN' },
  { label: 'Tâche planifiée (relances, vérifications)', ok: !!CRON_SECRET, detail: 'CRON_SECRET' },
];
const zones = [...s.delivery.zones, { id: '', label: '', fee: 0, delay: '', freeAbove: false, active: true }];
const socials = [...s.social, { label: '', href: '' }];
const ok = Astro.url.searchParams.get('ok');
---

<AdminLayout title="Paramètres">
  {ok && <p class="alert alert-success mb-4">Paramètres enregistrés. Visibles sur le site d'ici une minute.</p>}
  {errors.length > 0 && <div class="alert alert-error mb-4" role="alert"><ul class="list-disc pl-5">{errors.map((e) => <li>{e}</li>)}</ul></div>}

  {
    canGlobal && (
      <form method="post" class="card grid gap-4 p-5 sm:grid-cols-2">
        <input type="hidden" name="action" value="identite" />
        <h2 class="text-xl sm:col-span-2">Identité et coordonnées</h2>
        <label class="block"><span class="label">Nom</span><input name="name" value={s.identity.name} class="input !py-2" /></label>
        <label class="block"><span class="label">Signature</span><input name="tagline" value={s.identity.tagline} class="input !py-2" /></label>
        <label class="block sm:col-span-2"><span class="label">Description (moteurs de recherche)</span><textarea name="description" rows="2" maxlength="300" class="input">{s.identity.description}</textarea></label>
        <label class="block"><span class="label">Téléphone</span><input name="phone" value={s.contact.phone} class="input !py-2" /></label>
        <label class="block"><span class="label">WhatsApp (format international, ex. 22890000000)</span><input name="whatsapp" value={s.contact.whatsapp} class="input !py-2" /></label>
        <label class="block"><span class="label">E-mail</span><input name="email" type="email" value={s.contact.email} class="input !py-2" /></label>
        <label class="block"><span class="label">Horaires</span><input name="hours" value={s.contact.hours} class="input !py-2" /></label>
        <label class="block sm:col-span-2"><span class="label">Adresse</span><input name="address" value={s.contact.address} class="input !py-2" /></label>
        <fieldset class="sm:col-span-2">
          <legend class="label">Réseaux sociaux</legend>
          <div class="space-y-2" data-rows="social">
            {socials.map((x, i) => (
              <div class="grid grid-cols-[1fr_2fr_auto] gap-2" data-row>
                <input name={`social[${i}][label]`} value={x.label} class="input !py-2" placeholder="Facebook" />
                <input name={`social[${i}][href]`} value={x.href} class="input !py-2" placeholder="https://…" />
                <button type="button" class="btn btn-ghost btn-sm text-danger" data-remove-row>✕</button>
              </div>
            ))}
          </div>
          <button type="button" class="btn btn-secondary btn-sm mt-2" data-add-row="social">+ Réseau</button>
        </fieldset>
        <div class="sm:col-span-2"><button class="btn btn-primary btn-sm">Enregistrer</button></div>
      </form>
    )
  }

  {
    canCommerce && (
      <form method="post" class="card mt-6 p-5">
        <input type="hidden" name="action" value="livraison" />
        <h2 class="text-xl">Livraison</h2>
        <p class="hint">Frais recalculés par le serveur à chaque commande. « Offerte au-delà du seuil » : livraison gratuite dès le montant ci-dessous.</p>
        <div class="mt-3 overflow-x-auto">
          <table class="w-full min-w-[760px] text-sm">
            <thead class="text-left text-muted"><tr><th class="p-1">Identifiant</th><th class="p-1">Libellé</th><th class="p-1">Frais (FCFA)</th><th class="p-1">Délai</th><th class="p-1">Offerte au-delà du seuil</th><th class="p-1">Active</th><th /></tr></thead>
            <tbody data-rows="zones">
              {zones.map((z, i) => (
                <tr data-row>
                  <td class="p-1"><input name={`zones[${i}][id]`} value={z.id} class="input !py-2" /></td>
                  <td class="p-1"><input name={`zones[${i}][label]`} value={z.label} class="input !py-2" /></td>
                  <td class="p-1"><input name={`zones[${i}][fee]`} value={z.fee} inputmode="numeric" class="input !py-2" /></td>
                  <td class="p-1"><input name={`zones[${i}][delay]`} value={z.delay} class="input !py-2" /></td>
                  <td class="p-1 text-center"><input type="checkbox" name={`zones[${i}][freeAbove]`} checked={z.freeAbove} /></td>
                  <td class="p-1 text-center"><input type="checkbox" name={`zones[${i}][active]`} checked={z.active} /></td>
                  <td class="p-1"><button type="button" class="btn btn-ghost btn-sm text-danger" data-remove-row>✕</button></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <button type="button" class="btn btn-secondary btn-sm mt-2" data-add-row="zones">+ Zone</button>
        <label class="mt-4 block max-w-xs"><span class="label">Seuil de livraison offerte (FCFA)</span><input name="freeThreshold" value={s.delivery.freeThreshold} inputmode="numeric" class="input !py-2" /></label>

        <h2 class="mt-8 text-xl">Moyens de paiement</h2>
        <div class="mt-3 space-y-3">
          {s.payments.methods.map((m) => (
            <div class="grid gap-2 rounded-xl border border-line p-3 sm:grid-cols-[auto_1fr_2fr] sm:items-end">
              <label class="flex items-center gap-2 pb-2 text-sm font-semibold"><input type="checkbox" name={`pay-${m.id}-enabled`} checked={m.enabled} />Actif</label>
              <label class="block"><span class="label">Libellé</span><input name={`pay-${m.id}-label`} value={m.label} class="input !py-2" /></label>
              <label class="block"><span class="label">Description</span><input name={`pay-${m.id}-description`} value={m.description} class="input !py-2" /></label>
            </div>
          ))}
        </div>
        <button class="btn btn-primary btn-sm mt-4">Enregistrer livraison et paiement</button>
      </form>
    )
  }

  {
    canWelcome && (
      <form method="post" enctype="multipart/form-data" class="card mt-6 grid gap-4 p-5 sm:grid-cols-2" id="mot-du-dirigeant">
        <input type="hidden" name="action" value="mot" />
        <div class="sm:col-span-2">
          <h2 class="text-xl">Mot du dirigeant</h2>
          <p class="hint">Affiché sur la page <a href="/afrisime#histoire" target="_blank" class="underline">Qui sommes-nous › Notre histoire</a>.</p>
        </div>
        <label class="flex items-center gap-2 text-sm font-semibold sm:col-span-2"><input type="checkbox" name="enabled" checked={s.welcome.enabled} class="size-4 accent-brand-700" />Afficher le mot du dirigeant</label>
        <label class="block sm:col-span-2"><span class="label">Titre</span><input name="title" value={s.welcome.title} maxlength="120" class="input !py-2" /></label>
        <label class="block"><span class="label">Nom</span><input name="name" value={s.welcome.name} maxlength="120" class="input !py-2" placeholder="Prénom NOM" /></label>
        <label class="block"><span class="label">Fonction</span><input name="role" value={s.welcome.role} maxlength="120" class="input !py-2" /></label>
        <label class="block sm:col-span-2">
          <span class="label">Message</span>
          <textarea name="message" rows="10" maxlength="4000" class="input">{s.welcome.message}</textarea>
          <span class="hint block">Laissez une ligne vide entre deux paragraphes.</span>
        </label>
        <div class="sm:col-span-2">
          <span class="label">Photo</span>
          {s.welcome.photoId && (
            <div class="mb-2 flex items-center gap-3">
              <img src={imageUrl(s.welcome.photoId, 'mini')} alt="" class="h-20 w-16 rounded-lg object-cover" />
              <label class="flex items-center gap-2 text-sm text-danger"><input type="checkbox" name="removePhoto" />Retirer</label>
            </div>
          )}
          <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" class="input" />
          <span class="hint block">Portrait vertical de préférence. Sans photo, les initiales du nom s'affichent.</span>
        </div>
        <div class="sm:col-span-2"><button class="btn btn-primary btn-sm">Enregistrer</button></div>
      </form>
    )
  }

  {
    canWelcome && (
      <form method="post" enctype="multipart/form-data" class="card mt-6 space-y-4 p-5" id="videos-vitrines">
        <input type="hidden" name="action" value="vitrine" />
        <div>
          <h2 class="text-xl">Vidéos vitrines de l'accueil</h2>
          <p class="hint">
            Affichées à droite de « La distribution alimentaire, autrement. », l'une après l'autre, sans le son et sans que les visiteurs puissent cliquer.
            Envoyez une courte vidéo (MP4, 4 Mo max) ou collez un lien YouTube / Vimeo pour une vidéo plus longue.
          </p>
        </div>
        <label class="flex items-center gap-2 text-sm font-semibold"><input type="checkbox" name="enabled" checked={s.showcase.enabled} class="size-4 accent-brand-700" />Afficher les vidéos</label>

        {
          s.showcase.videos.length > 0 && (
            <ul class="space-y-2">
              {s.showcase.videos.map((v, i) => (
                <li class="grid gap-2 rounded-xl border border-line p-3 sm:grid-cols-[160px_1fr_80px_auto] sm:items-center">
                  <input type="hidden" name={`videos[${i}][mediaId]`} value={v.mediaId} />
                  {v.mediaId ? (
                    <video src={videoUrl(v.mediaId)} muted playsinline preload="metadata" class="aspect-video w-40 rounded-lg bg-black object-cover" />
                  ) : (
                    <span class="grid aspect-video w-40 place-items-center rounded-lg bg-canvas px-2 text-center text-xs text-muted">Lien vidéo</span>
                  )}
                  <div class="space-y-2">
                    <input name={`videos[${i}][title]`} value={v.title} maxlength="120" class="input !py-2" placeholder="Titre affiché (facultatif)" />
                    {v.mediaId ? <input type="hidden" name={`videos[${i}][url]`} value="" /> : <input name={`videos[${i}][url]`} value={v.url} class="input !py-2 text-xs" />}
                  </div>
                  <label class="block text-xs"><span class="label">Ordre</span><input name={`videos[${i}][position]`} value={i + 1} inputmode="numeric" class="input !py-2" /></label>
                  <label class="flex items-center gap-2 text-sm text-danger"><input type="checkbox" name={`videos[${i}][remove]`} />Retirer</label>
                </li>
              ))}
            </ul>
          )
        }

        <fieldset class="rounded-xl border border-dashed border-line p-4">
          <legend class="px-1 text-sm font-bold">Ajouter une vidéo</legend>
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="block sm:col-span-2"><span class="label">Titre affiché <span class="font-normal text-muted">(facultatif)</span></span><input name="newTitle" maxlength="120" class="input !py-2" placeholder="Ex. : Notre dépôt de Lomé" /></label>
            <label class="block"><span class="label">Fichier vidéo</span><input type="file" name="newFile" accept="video/mp4,video/webm" class="input !py-1.5" /><span class="hint block">MP4 ou WebM, 4 Mo maximum (≈ 15 à 30 s en 720p).</span></label>
            <label class="block"><span class="label">… ou lien</span><input name="newUrl" class="input !py-2" placeholder="https://www.youtube.com/watch?v=…" /><span class="hint block">YouTube, Vimeo ou fichier MP4 hébergé (https).</span></label>
          </div>
        </fieldset>
        <button class="btn btn-primary btn-sm">Enregistrer</button>
      </form>
    )
  }

  <section class="card mt-6 p-5" aria-labelledby="titre-integrations">
    <h2 id="titre-integrations" class="text-xl">Intégrations</h2>
    <p class="hint">Réglées par variables d'environnement sur l'hébergeur (voir docs/deploiement.md). Aucun secret n'est affiché ici.</p>
    <ul class="mt-3 divide-y divide-line text-sm">
      {
        integrations.map((i) => (
          <li class="flex flex-wrap items-center justify-between gap-2 py-2">
            <span class="font-semibold">{i.label}</span>
            <span class:list={['badge', i.ok ? 'badge-populaire' : 'badge-sur-commande']}>{i.ok ? 'Actif' : 'Non configuré'}</span>
            {!i.ok && <span class="w-full text-xs text-muted">Variables : {i.detail}</span>}
          </li>
        ))
      }
    </ul>
  </section>
</AdminLayout>

<script>
  import { initAdminForms } from '../../scripts/admin';
  initAdminForms();
</script>

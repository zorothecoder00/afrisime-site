---
// Médiathèque : envoi d'images (compressées en WebP), texte alternatif, suppression.
// Les documents privés joints aux demandes n'apparaissent pas ici (fiche du lead).
import { and, count, desc, eq, sql } from 'drizzle-orm';
import { cardTint } from '../../lib/tints';
import AdminLayout from '../../components/AdminLayout.astro';
import Pagination from '../../components/admin/Pagination.astro';
import { brands, campaigns, categories, contents, media, products } from '../../db/schema';
import { str } from '../../lib/admin';
import { audit } from '../../lib/audit';
import { invalidateCatalog } from '../../lib/catalog';
import { invalidateContent } from '../../lib/content';
import { db } from '../../lib/db';
import { formatDateTime } from '../../lib/format';
import { imageUrl, storeUpload, UploadError } from '../../lib/media';
import { can } from '../../lib/roles';
import { slideshowUsage } from '../../lib/slideshows';

const me = Astro.locals.user!;
if (!can(me.role, { content: ['update'] }) && !can(me.role, { catalog: ['update'] })) return new Response('Accès refusé.', { status: 403 });
const PAGE_SIZE = 48;
const errors: string[] = [];
let uploaded = 0;

/** Un média encore utilisé ne peut pas être supprimé (photo produit, couverture, logo, diaporama…). */
async function usage(id: string) {
  const [p, c, b, k, cp, sl] = await Promise.all([
    db.select({ n: count() }).from(products).where(sql`${products.imageIds} ? ${id}`),
    db.select({ n: count() }).from(contents).where(sql`${contents.coverId} = ${id} or ${contents.body} like ${`%/img/${id}%`}`),
    db.select({ n: count() }).from(brands).where(eq(brands.logoId, id)),
    db.select({ n: count() }).from(categories).where(eq(categories.imageId, id)),
    db.select({ n: count() }).from(campaigns).where(eq(campaigns.imageId, id)),
    slideshowUsage(id),
  ]);
  return p[0].n + c[0].n + b[0].n + k[0].n + cp[0].n + sl;
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = str(form, 'action');
  const id = str(form, 'id', 40);

  if (action === 'upload') {
    for (const file of form.getAll('files')) {
      if (typeof file === 'string' || file.size === 0) continue;
      try {
        await storeUpload(file, { uploadedBy: me.id, alt: str(form, 'alt', 300) });
        uploaded++;
      } catch (err) {
        errors.push(err instanceof UploadError ? err.message : `« ${file.name} » n'a pas pu être enregistré.`);
      }
    }
    if (uploaded) await audit({ actorId: me.id, action: 'medias-envoyes', details: { nombre: uploaded }, ipAddress: Astro.clientAddress });
  }
  if (action === 'alt') {
    await db.update(media).set({ alt: str(form, 'alt', 300) }).where(and(eq(media.id, id), eq(media.private, false)));
    invalidateCatalog();
    invalidateContent();
  }
  if (action === 'delete') {
    const used = await usage(id);
    if (used > 0) errors.push(`Ce média est encore utilisé (${used} fois) : retirez-le d'abord des produits, contenus ou diaporamas concernés.`);
    else {
      await db.delete(media).where(and(eq(media.id, id), eq(media.private, false)));
      await audit({ actorId: me.id, action: 'media-supprime', target: id, ipAddress: Astro.clientAddress });
    }
  }
  if (!errors.length) return Astro.redirect(`/admin/medias?ok=${action}${uploaded ? `&n=${uploaded}` : ''}`, 303);
}

const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const where = and(eq(media.private, false), eq(media.kind, 'image'));
const [items, [{ total }]] = await Promise.all([
  db
    .select({ id: media.id, filename: media.filename, alt: media.alt, width: media.width, height: media.height, size: media.size, createdAt: media.createdAt })
    .from(media)
    .where(where)
    .orderBy(desc(media.createdAt))
    .limit(PAGE_SIZE)
    .offset((page - 1) * PAGE_SIZE),
  db.select({ total: count() }).from(media).where(where),
]);
const ok = Astro.url.searchParams.get('ok');
---

<AdminLayout title="Médias">
  {ok === 'upload' && <p class="alert alert-success mb-4">{Astro.url.searchParams.get('n')} image(s) ajoutée(s).</p>}
  {ok === 'alt' && <p class="alert alert-success mb-4">Texte alternatif enregistré.</p>}
  {ok === 'delete' && <p class="alert alert-success mb-4">Image supprimée.</p>}
  {errors.length > 0 && <div class="alert alert-error mb-4" role="alert"><ul class="list-disc pl-5">{errors.map((e) => <li>{e}</li>)}</ul></div>}

  <p class="hint mb-4">
    La médiathèque est une réserve d'images : une image n'apparaît sur le site qu'une fois utilisée, dans un
    <a href="/admin/diaporamas" class="font-semibold underline">diaporama</a>, une fiche produit, un article (couverture ou « Code Markdown » collé dans le texte), une marque, une catégorie ou une campagne.
  </p>

  <form method="post" enctype="multipart/form-data" class:list={['card grid gap-3 p-5 sm:grid-cols-[2fr_2fr_auto] sm:items-end', cardTint(0)]} data-media-upload>
    <input type="hidden" name="action" value="upload" />
    <label class="block"><span class="label">Images (une ou plusieurs)</span><input type="file" name="files" multiple required accept="image/jpeg,image/png,image/webp,image/avif,image/gif" class="input" /></label>
    <label class="block"><span class="label">Texte alternatif</span><input name="alt" maxlength="300" class="input" placeholder="Décrit l'image (accessibilité, SEO)" /></label>
    <button type="submit" class="btn btn-primary">Envoyer</button>
    <p class="hint sm:col-span-3">
      Plusieurs images d'un coup : dans la fenêtre de sélection, maintenez <kbd>Ctrl</kbd> (<kbd>Cmd</kbd> sur Mac) en cliquant sur chaque image, <kbd>Maj</kbd> pour une série, ou <kbd>Ctrl</kbd>+<kbd>A</kbd> pour tout le dossier. Vous pouvez aussi glisser les fichiers sur le champ.
      JPG, PNG, WebP, AVIF ou GIF, 8 Mo max par image. Converties en WebP (1600 px max) avec une miniature.
    </p>
    <ul class="hidden space-y-1 text-sm sm:col-span-3" data-upload-list></ul>
  </form>

  <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
    {
      items.map((m) => (
        <li class:list={['card overflow-hidden text-xs', cardTint(1)]}>
          <a href={imageUrl(m.id)} target="_blank"><img src={imageUrl(m.id, 'mini')} alt={m.alt} loading="lazy" class="aspect-square w-full bg-canvas object-contain" /></a>
          <div class="space-y-2 p-3">
            <p class="truncate font-semibold" title={m.filename}>{m.filename}</p>
            <p class="text-muted">{m.width}×{m.height} · {Math.round(m.size / 1024)} Ko · {formatDateTime(m.createdAt)}</p>
            <form method="post" class="flex gap-1">
              <input type="hidden" name="action" value="alt" />
              <input type="hidden" name="id" value={m.id} />
              <input name="alt" value={m.alt} maxlength="300" class="input !px-2 !py-1 text-xs" aria-label="Texte alternatif" placeholder="Texte alternatif" />
              <button class="btn btn-secondary btn-sm">OK</button>
            </form>
            <div class="flex flex-wrap gap-1">
              <button type="button" class="btn btn-ghost btn-sm" data-copy={`![${m.alt}](${imageUrl(m.id)})`}>Code Markdown</button>
              <form method="post">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={m.id} />
                <button class="btn btn-ghost btn-sm text-danger" data-confirm="Supprimer cette image ?">Supprimer</button>
              </form>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
  <Pagination total={total} page={page} pageSize={PAGE_SIZE} />
</AdminLayout>

<script>
  import { initAdminForms } from '../../scripts/admin';
  initAdminForms();

  // Envoi image par image : l'hébergeur limite chaque requête à 4,5 Mo, et chaque fichier
  // affiche son propre résultat. Sans JavaScript, le formulaire s'envoie en une fois.
  const form = document.querySelector<HTMLFormElement>('[data-media-upload]')!;
  const input = form.querySelector<HTMLInputElement>('input[type="file"]')!;
  const list = form.querySelector<HTMLUListElement>('[data-upload-list]')!;
  const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

  const kb = (n: number) => (n > 1024 * 1024 ? `${(n / 1024 / 1024).toFixed(1)} Mo` : `${Math.round(n / 1024)} Ko`);
  const renderList = () => {
    const files = [...(input.files ?? [])];
    list.classList.toggle('hidden', files.length === 0);
    list.replaceChildren(
      ...files.map((f) => {
        const li = document.createElement('li');
        li.className = 'flex justify-between gap-3 rounded-lg bg-canvas px-3 py-1.5';
        li.innerHTML = '<span class="truncate"></span><span class="shrink-0 text-muted" data-state></span>';
        li.firstElementChild!.textContent = f.name;
        li.lastElementChild!.textContent = kb(f.size);
        return li;
      }),
    );
    submit.textContent = files.length > 1 ? `Envoyer les ${files.length} images` : 'Envoyer';
  };
  input.addEventListener('change', renderList);

  form.addEventListener('submit', async (event) => {
    const files = [...(input.files ?? [])];
    if (!files.length) return;
    event.preventDefault();
    submit.disabled = true;
    input.disabled = true;
    const alt = (form.elements.namedItem('alt') as HTMLInputElement).value;
    let sent = 0;
    for (const [i, file] of files.entries()) {
      const state = list.children[i].querySelector<HTMLElement>('[data-state]')!;
      state.textContent = 'Envoi…';
      const data = new FormData();
      data.set('action', 'upload');
      data.set('alt', alt);
      data.append('files', file);
      try {
        const res = await fetch(form.action || location.pathname, { method: 'POST', body: data });
        // Succès : le serveur redirige vers ?ok=upload ; sinon il renvoie la page avec le message d'erreur.
        if (res.ok && res.redirected && res.url.includes('ok=upload')) {
          sent++;
          state.textContent = '✓ Ajoutée';
          state.className = 'shrink-0 font-semibold text-brand-700';
        } else {
          const message = res.status === 413 ? 'Fichier trop lourd pour l’envoi' : new DOMParser().parseFromString(await res.text(), 'text/html').querySelector('.alert-error li')?.textContent;
          state.textContent = `✗ ${message ?? 'Échec'}`;
          state.className = 'shrink-0 font-semibold text-danger';
        }
      } catch {
        state.textContent = '✗ Connexion impossible';
        state.className = 'shrink-0 font-semibold text-danger';
      }
    }
    if (sent === files.length) location.href = `/admin/medias?ok=upload&n=${sent}`;
    else {
      submit.disabled = false;
      input.disabled = false;
      submit.textContent = sent ? `${sent} image(s) ajoutée(s) — voir la médiathèque` : 'Réessayer';
      if (sent) submit.onclick = (e) => ((e.preventDefault(), (location.href = `/admin/medias?ok=upload&n=${sent}`)));
    }
  });
</script>

---
// FAQ : questions par rubrique, ordre, publication.
import { asc, eq } from 'drizzle-orm';
import AdminLayout from '../../components/AdminLayout.astro';
import { faqItems } from '../../db/schema';
import { bool, deny, int, str } from '../../lib/admin';
import { audit } from '../../lib/audit';
import { FAQ_GROUPS, invalidateContent } from '../../lib/content';
import { db } from '../../lib/db';

const me = Astro.locals.user!;
const denied = deny(me, { content: ['update'] });
if (denied) return denied;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = str(form, 'action');
  const id = str(form, 'id', 80);
  if (action === 'delete') {
    await db.delete(faqItems).where(eq(faqItems.id, id));
  } else {
    const values = {
      group: FAQ_GROUPS.some((g) => g.id === str(form, 'group')) ? str(form, 'group') : 'general',
      question: str(form, 'question', 300),
      answer: str(form, 'answer', 3000),
      position: int(form, 'position') ?? 0,
      published: bool(form, 'published'),
    };
    if (values.question.length < 5 || values.answer.length < 5) error = 'Question et réponse sont obligatoires.';
    else if (action === 'create') await db.insert(faqItems).values({ id: crypto.randomUUID(), ...values });
    else await db.update(faqItems).set(values).where(eq(faqItems.id, id));
  }
  if (!error) {
    await audit({ actorId: me.id, action: `faq-${action}`, target: id || undefined, ipAddress: Astro.clientAddress });
    invalidateContent();
    return Astro.redirect('/admin/faq?ok=1', 303);
  }
}

const items = await db.select().from(faqItems).orderBy(asc(faqItems.position), asc(faqItems.question));
---

<AdminLayout title="FAQ">
  {Astro.url.searchParams.has('ok') && <p class="alert alert-success mb-4">FAQ mise à jour. Visible sur le site d'ici une minute.</p>}
  {error && <p class="alert alert-error mb-4" role="alert">{error}</p>}

  {
    FAQ_GROUPS.map((g) => (
      <section class="mb-8">
        <h2 class="text-xl">{g.title}</h2>
        <div class="mt-3 space-y-2">
          {items
            .filter((q) => q.group === g.id)
            .map((q) => (
              <details class="card p-4">
                <summary class="cursor-pointer font-semibold">
                  {q.position}. {q.question} {!q.published && <span class="badge badge-rupture ml-2">Masquée</span>}
                </summary>
                <form method="post" class="mt-3 grid gap-3 sm:grid-cols-4">
                  <input type="hidden" name="id" value={q.id} />
                  <label class="block sm:col-span-3"><span class="label">Question</span><input name="question" value={q.question} class="input !py-2" /></label>
                  <label class="block"><span class="label">Ordre</span><input name="position" value={q.position} inputmode="numeric" class="input !py-2" /></label>
                  <label class="block sm:col-span-4"><span class="label">Réponse</span><textarea name="answer" rows="3" class="input">{q.answer}</textarea></label>
                  <label class="block">
                    <span class="label">Rubrique</span>
                    <select name="group" class="input !py-2">{FAQ_GROUPS.map((x) => <option value={x.id} selected={x.id === q.group}>{x.title}</option>)}</select>
                  </label>
                  <label class="flex items-end gap-2 pb-2 text-sm"><input type="checkbox" name="published" checked={q.published} />Publiée</label>
                  <div class="flex items-end gap-2 sm:col-span-2">
                    <button name="action" value="update" class="btn btn-primary btn-sm">Enregistrer</button>
                    <button name="action" value="delete" class="btn btn-ghost btn-sm text-danger" data-confirm="Supprimer cette question ?">Supprimer</button>
                  </div>
                </form>
              </details>
            ))}
        </div>
      </section>
    ))
  }

  <form method="post" class="card grid gap-3 p-5 sm:grid-cols-4">
    <h2 class="text-lg sm:col-span-4">Nouvelle question</h2>
    <label class="block sm:col-span-3"><span class="label">Question</span><input name="question" required class="input !py-2" /></label>
    <label class="block"><span class="label">Ordre</span><input name="position" value={items.length + 1} inputmode="numeric" class="input !py-2" /></label>
    <label class="block sm:col-span-4"><span class="label">Réponse</span><textarea name="answer" rows="3" required class="input"></textarea></label>
    <label class="block">
      <span class="label">Rubrique</span>
      <select name="group" class="input !py-2">{FAQ_GROUPS.map((x) => <option value={x.id}>{x.title}</option>)}</select>
    </label>
    <label class="flex items-end gap-2 pb-2 text-sm"><input type="checkbox" name="published" checked />Publiée</label>
    <div class="flex items-end sm:col-span-2"><button name="action" value="create" class="btn btn-primary btn-sm">Ajouter</button></div>
  </form>
</AdminLayout>

<script>
  import { initAdminForms } from '../../scripts/admin';
  initAdminForms();
</script>

---
// Tableau de bord du back-office. Accès : équipe AfriSime avec double authentification
// (contrôlé par src/middleware.ts). Chaque bloc dépend des permissions du rôle.
import { count, desc, eq, sql } from 'drizzle-orm';
import AdminLayout from '../../components/AdminLayout.astro';
import LeadsTable from '../../components/admin/LeadsTable.astro';
import OrdersTable from '../../components/admin/OrdersTable.astro';
import { contents, leads, orders, products, user as users } from '../../db/schema';
import { abandonedCarts, commerceStats } from '../../lib/reports';
import { db } from '../../lib/db';
import { formatPrice } from '../../lib/format';
import { listLeads } from '../../lib/leads';
import { can } from '../../lib/roles';

export const prerender = false;

const me = Astro.locals.user!;
const canOrders = can(me.role, { order: ['read'] });
const canLeads = can(me.role, { lead: ['read'] });
const canUsers = can(me.role, { user: ['list'] });

const today = sql`${orders.createdAt} >= date_trunc('day', now())`;

const [orderStats, leadStats, userStats, recentOrders, recentLeads] = await Promise.all([
  canOrders
    ? db
        .select({
          today: sql<number>`count(*) filter (where ${today})`.mapWith(Number),
          revenueToday: sql<number>`coalesce(sum(${orders.total}) filter (where ${today} and ${orders.status} <> 'annulee'), 0)`.mapWith(Number),
          notSynced: sql<number>`count(*) filter (where ${orders.erpSyncedAt} is null and ${orders.status} not in ('en-attente-paiement', 'annulee'))`.mapWith(Number),
        })
        .from(orders)
        .then((r) => r[0])
    : null,
  canLeads ? db.select({ total: count() }).from(leads).where(eq(leads.status, 'nouveau')).then((r) => r[0]) : null,
  canUsers ? db.select({ total: count() }).from(users).then((r) => r[0]) : null,
  canOrders ? db.select().from(orders).orderBy(desc(orders.createdAt)).limit(8) : [],
  canLeads ? listLeads({ limit: 8 }).then((r) => r.rows) : [],
]);

const canPublish = can(me.role, { content: ['publish'] });
const canPro = can(me.role, { pro: ['validate'] });
const canCatalog = can(me.role, { catalog: ['read'] });
const [toReview, prosPending, abandoned, month, catalogCounts] = await Promise.all([
  canPublish ? db.select({ total: count() }).from(contents).where(eq(contents.status, 'a-valider')).then((r) => r[0].total) : null,
  canPro ? db.select({ total: count() }).from(users).where(eq(users.proStatus, 'en-attente')).then((r) => r[0].total) : null,
  canOrders ? abandonedCarts(200).then((r) => r.length) : null,
  canOrders ? commerceStats(new Date(Date.now() - 30 * 86_400_000)) : null,
  canCatalog
    ? db
        .select({
          total: count(),
          unavailable: sql<number>`count(*) filter (where ${products.status} = 'indisponible')`.mapWith(Number),
        })
        .from(products)
        .then((r) => r[0])
    : null,
]);

const stats = [
  orderStats && { label: "Commandes aujourd'hui", value: String(orderStats.today), href: '/admin/commandes' },
  orderStats && { label: "Chiffre d'affaires du jour", value: formatPrice(orderStats.revenueToday) },
  month && { label: 'Ventes sur 30 jours', value: formatPrice(month.revenue), href: '/admin/rapports' },
  month && { label: 'Panier moyen (30 j)', value: formatPrice(month.averageBasket), href: '/admin/rapports' },
  abandoned !== null && { label: 'Paniers abandonnés', value: String(abandoned), href: '/admin/rapports#t-paniers' },
  orderStats && { label: "Non transmises à l'ERP", value: String(orderStats.notSynced), href: '/admin/commandes?erp=attente' },
  leadStats && { label: 'Nouveaux leads', value: String(leadStats.total), href: '/admin/leads?statut=nouveau' },
  prosPending !== null && { label: 'Comptes pro à valider', value: String(prosPending), href: '/admin/utilisateurs?filtre=a-valider' },
  toReview !== null && { label: 'Contenus à valider', value: String(toReview), href: '/admin/contenus?statut=a-valider' },
  catalogCounts && { label: 'Produits (indisponibles)', value: `${catalogCounts.total} (${catalogCounts.unavailable})`, href: '/admin/catalogue' },
  userStats && { label: 'Comptes', value: String(userStats.total), href: can(me.role, { user: ['list'] }) ? '/admin/utilisateurs' : undefined },
].filter(Boolean) as { label: string; value: string; href?: string }[];
---

<AdminLayout title="Tableau de bord">
  <div class="space-y-10">
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-5">
      {
        stats.map((s) => (
          <li>
            <a href={s.href} class:list={['card block h-full p-4', s.href && 'hover:border-brand-600']}>
              <p class="text-sm text-muted">{s.label}</p>
              <p class="mt-1 text-2xl font-extrabold text-brand-900">{s.value}</p>
            </a>
          </li>
        ))
      }
    </ul>

    {
      canOrders && (
        <section aria-labelledby="titre-commandes">
          <div class="mb-3 flex items-baseline justify-between gap-3">
            <h2 id="titre-commandes" class="text-xl">Dernières commandes</h2>
            <a href="/admin/commandes" class="text-sm font-semibold text-brand-700 underline">Toutes les commandes</a>
          </div>
          <OrdersTable rows={recentOrders} empty="Aucune commande pour le moment." />
        </section>
      )
    }

    {
      canLeads && (
        <section aria-labelledby="titre-leads">
          <div class="mb-3 flex items-baseline justify-between gap-3">
            <h2 id="titre-leads" class="text-xl">Derniers leads</h2>
            <a href="/admin/leads" class="text-sm font-semibold text-brand-700 underline">Tous les leads</a>
          </div>
          <LeadsTable rows={recentLeads} empty="Aucune demande pour le moment." />
        </section>
      )
    }
  </div>
</AdminLayout>

---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Slideshow from '../components/Slideshow.astro';
import Icon, { type IconName } from '../components/ui/Icon.astro';
import { imageUrl } from '../lib/media';
import { getSettings } from '../lib/settings';
import { getPageTexts } from '../lib/page-texts';
import { cardTint } from '../lib/tints';

// Mot du dirigeant : modifiable dans le back-office (Paramètres › Mot du dirigeant).
const { welcome } = await getSettings();
const paragraphs = welcome.message.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const initials = welcome.name
  .replace(/^(le|la|les)\s+/i, '')
  .split(/\s+/)
  .filter((w) => /^\p{Lu}/u.test(w))
  .slice(0, 2)
  .map((w) => w[0])
  .join('') || 'AS';

// Textes modifiables dans le back-office (Textes du site › Qui sommes-nous).
const t = await getPageTexts('afrisime');
const history = t.historyText.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

const valueIcons: IconName[] = ['shield', 'users', 'leaf', 'star'];
const values = t.values.map((v, i) => ({ ...v, icon: valueIcons[i] }));
---

<Layout title="Qui sommes-nous" description={t.seoDescription}>
  <PageHero
    eyebrow={t.heroEyebrow}
    title={t.heroTitle}
    intro={t.heroText}
    breadcrumbs={[{ label: 'AfriSime' }]}
    media="entete-afrisime"
  />

  {
    welcome.enabled && welcome.message.trim() && (
      <section id="mot-du-dirigeant" class="section scroll-mt-32 !pb-0" aria-labelledby="mot-du-dirigeant-titre">
        <figure class="container-page">
          <div class="relative overflow-hidden rounded-3xl bg-brand-50 ring-1 ring-brand-100 lg:grid lg:grid-cols-[320px_1fr]">
            <div class="relative flex items-center justify-center bg-brand-900 p-8 lg:p-10">
              <div class="absolute inset-0 opacity-[0.08]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 18px 18px;" />
              {welcome.photoId ? (
                <img
                  src={imageUrl(welcome.photoId)}
                  alt={`Portrait de ${welcome.name}`}
                  class="relative aspect-[4/5] w-56 rounded-2xl object-cover shadow-xl lg:w-full"
                />
              ) : (
                <span class="relative grid aspect-square w-40 place-items-center rounded-full bg-accent-500 text-5xl font-extrabold text-brand-950 shadow-xl" aria-hidden="true">
                  {initials}
                </span>
              )}
            </div>
            <div class="relative p-8 sm:p-12">
              <span class="pointer-events-none absolute right-6 top-2 font-serif text-[9rem] leading-none text-brand-200 select-none" aria-hidden="true">
                “
              </span>
              <p class="eyebrow">{t.welcomeEyebrow}</p>
              <h2 id="mot-du-dirigeant-titre" class="relative mt-2 text-3xl">{welcome.title}</h2>
              <blockquote class="relative mt-6 space-y-4 text-lg leading-relaxed text-ink">
                {paragraphs.map((p) => <p>{p}</p>)}
              </blockquote>
              <figcaption class="mt-8 flex items-center gap-4 border-t border-brand-200 pt-6">
                <span class="h-10 w-1 rounded-full bg-accent-500" aria-hidden="true" />
                <span>
                  <span class="block text-lg font-extrabold text-brand-900">{welcome.name}</span>
                  <span class="text-sm text-muted">{welcome.role}</span>
                </span>
              </figcaption>
            </div>
          </div>
        </figure>
      </section>
    )
  }

  <section class="border-b border-line bg-white">
    <dl class="container-page grid grid-cols-2 gap-4 py-10 md:grid-cols-4">
      {
        t.figures.map((f, i) => (
          <div class:list={['rounded-2xl border p-5 sm:p-6', cardTint(i)]}>
            <dt class="sr-only">{f.label}</dt>
            <dd><span class="block text-3xl font-extrabold text-brand-900 sm:text-4xl">{f.value}</span><span class="text-sm text-ink/70">{f.label}</span></dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section id="histoire" class="section scroll-mt-32">
    <div class="container-page grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">{t.historyEyebrow}</p>
        <h2 class="mt-2 text-3xl">{t.historyTitle}</h2>
      </div>
      <div class="space-y-4 text-lg leading-relaxed text-ink">
        {history.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <Slideshow placement="afrisime" class="section !pt-0" />

  <section id="vision" class="section scroll-mt-32 bg-brand-900 text-white">
    <div class="container-page grid gap-6 md:grid-cols-2">
      <div class="rounded-3xl bg-brand-800 p-8">
        <p class="eyebrow !text-accent-500">{t.visionLabel}</p>
        <p class="mt-3 text-2xl font-bold leading-snug">{t.vision}</p>
      </div>
      <div class="rounded-3xl bg-brand-800 p-8">
        <p class="eyebrow !text-accent-500">{t.missionLabel}</p>
        <p class="mt-3 text-2xl font-bold leading-snug">{t.mission}</p>
      </div>
    </div>
  </section>

  <section id="valeurs" class="section scroll-mt-32">
    <div class="container-page">
      <p class="eyebrow">{t.valuesEyebrow}</p>
      <h2 class="mt-2 text-3xl">{t.valuesTitle}</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((v, i) => <li class:list={['card p-6', cardTint(i)]}><Icon name={v.icon} size={28} class="text-brand-600" /><h3 class="mt-4 text-lg">{v.title}</h3><p class="mt-1 text-sm text-muted">{v.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section id="gouvernance" class="section scroll-mt-32 bg-white">
    <div class="container-page grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">{t.governanceEyebrow}</p>
        <h2 class="mt-2 text-3xl">{t.governanceTitle}</h2>
        <p class="mt-4 text-muted">{t.governanceText}</p>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2">
        {t.governancePoles.map((p) => <li class="card p-4 font-semibold text-brand-900">{p}</li>)}
      </ul>
    </div>
  </section>

  <section id="engagements" class="section scroll-mt-32">
    <div class="container-page">
      <p class="eyebrow">{t.commitmentsEyebrow}</p>
      <h2 class="mt-2 text-3xl">{t.commitmentsTitle}</h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {t.commitments.map((c) => <li class="card p-6"><h3 class="text-lg">{c.title}</h3><p class="mt-1 text-muted">{c.text}</p></li>)}
      </ul>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="/investir" class="btn btn-primary">{t.ctaInvest}</a>
        <a href="/carrieres" class="btn btn-secondary">{t.ctaJoin}</a>
      </div>
    </div>
  </section>
</Layout>

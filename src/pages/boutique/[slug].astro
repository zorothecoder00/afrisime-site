---
// Fiche produit, sur le modèle des fiches Alibaba : galerie à vignettes verticales à gauche,
// colonne d'achat (prix par format, variations, quantité, livraison, protections, actions) à droite,
// puis attributs clés, emballage et livraison, description et produits similaires.
import Layout from '../../layouts/Layout.astro';
import FavoriteButton from '../../components/FavoriteButton.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Icon from '../../components/ui/Icon.astro';
import ProductImage from '../../components/ui/ProductImage.astro';
import { canBuyOnline, cartPayload, getCatalog, lowestVariant, productUrl, type Product } from '../../lib/catalog';
import { BADGE_LABELS, STATUS_LABELS, formatPrice } from '../../lib/format';
import { imageUrl } from '../../lib/media';
import { findRedirect } from '../../lib/redirects';
import { activeZones, contactLinks, getSettings } from '../../lib/settings';
import { SITE } from '../../data/site';

const { products, categoryOf, brandOf } = await getCatalog();
const product = products.find((x) => x.slug === Astro.params.slug);
if (!product) {
  // Adresse modifiée ou produit retiré : redirection si elle a été prévue, sinon page 404.
  const redirect = await findRedirect(Astro.url.pathname);
  if (redirect) return Astro.redirect(redirect.to, redirect.status as 301);
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const settings = await getSettings();
const links = contactLinks(settings.contact);
const p = product.data;
const category = categoryOf(product);
const brand = brandOf(product);
const defaultVariant = lowestVariant(product);
const buyable = canBuyOnline(product);
const isDevis = p.status === 'devis';
const hasProPrices = p.variants.some((v) => v.proPrice && v.proPrice < v.price);
const zones = activeZones(settings);
const cheapestDelivery = zones.filter((z) => z.fee > 0).sort((a, b) => a.fee - b.fee)[0];
const pickup = zones.find((z) => z.id === 'retrait');

const prices = p.variants.map((v) => v.price);
const amount = (n: number) => formatPrice(n).replace(/\s*FCFA$/, '');
const priceRange = Math.min(...prices) === Math.max(...prices) ? formatPrice(prices[0]) : `${amount(Math.min(...prices))}-${amount(Math.max(...prices))} FCFA`;
const discount = (v: (typeof p.variants)[number]) => (v.compareAtPrice && v.compareAtPrice > v.price ? Math.round((1 - v.price / v.compareAtPrice) * 100) : 0);
const bestDiscount = Math.max(0, ...p.variants.map(discount));

const related = p.related
  .map((id) => products.find((x) => x.id === id))
  .filter((x): x is Product => !!x)
  .concat(products.filter((x) => x.id !== product.id && x.data.category.id === category.id && !p.related.includes(x.id)))
  .slice(0, 5);

const availability = {
  disponible: 'https://schema.org/InStock',
  'sur-commande': 'https://schema.org/PreOrder',
  indisponible: 'https://schema.org/OutOfStock',
  devis: 'https://schema.org/LimitedAvailability',
}[p.status];

const url = new URL(productUrl(product), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  sku: p.sku,
  description: p.summary,
  category: category.data.name,
  brand: { '@type': 'Brand', name: brand.data.name },
  image: p.images.map((i) => new URL(imageUrl(i.id), Astro.site).href),
  offers: p.variants.map((v) => ({
    '@type': 'Offer',
    sku: `${p.sku}-${v.id}`,
    name: v.label,
    price: v.price,
    priceCurrency: SITE.currency,
    availability,
    url,
  })),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Boutique', item: new URL('/boutique', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: category.data.name, item: new URL(`/boutique?categorie=${category.id}`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: p.name, item: url },
  ],
};

const whatsappText = encodeURIComponent(`Bonjour AfriSime, je souhaite des informations sur : ${p.name} (${p.sku}).`);
const statusDot = { disponible: 'bg-brand-600', 'sur-commande': 'bg-warning', indisponible: 'bg-danger', devis: 'bg-info' }[p.status];
const statusNote = {
  disponible: p.stock !== null && p.stock > 0 && p.stock <= 10 ? `Plus que ${p.stock} en stock.` : 'En stock, prêt à être livré.',
  'sur-commande': 'Commandable en ligne : livraison sous 3 à 7 jours après confirmation.',
  indisponible: 'Réassort en cours. Contactez-nous pour connaître la date de retour.',
  devis: 'Ce produit est vendu sur devis selon les volumes.',
}[p.status];
const leadTime = p.leadTime || (p.status === 'sur-commande' ? '3 à 7 jours' : 'Sous 24 h à Lomé centre');
const devisHref = `/b2b?produit=${encodeURIComponent(p.name)}#devis`;

// Attributs clés (tableau à deux colonnes, comme sur Alibaba).
const attributes: [string, string][] = [
  ['Marque', brand.data.name],
  ['Référence', p.sku],
  ['Catégorie', category.data.name],
  ['Origine', p.origin === 'local' ? 'Produit local (Togo)' : 'Importé'],
  ['Formats disponibles', p.variants.map((v) => v.label).join(', ')],
  ['Disponibilité', STATUS_LABELS[p.status]],
];
// Caractéristiques saisies dans le back-office, sans répéter un attribut déjà affiché.
for (const f of p.features) {
  if (!attributes.some(([label]) => label.toLowerCase() === f.label.toLowerCase())) attributes.push([f.label, f.value]);
}
---

<Layout
  title={p.seoTitle || `${p.name} – ${brand.data.name}`}
  description={p.seoDescription || `${p.summary} Réf. ${p.sku}. À partir de ${formatPrice(defaultVariant.price)}.`}
  imageId={p.images[0]?.id}
  jsonLd={[jsonLd, breadcrumbLd]}
>
  <div class="container-page py-5">
    <Breadcrumbs items={[{ label: 'Boutique', href: '/boutique' }, { label: category.data.name, href: `/boutique?categorie=${category.id}` }, { label: p.name }]} />
  </div>

  <div class="container-page grid gap-6 pb-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-10">
    <!-- ───────── Colonne gauche : galerie ───────── -->
    <section aria-label="Photos du produit" data-gallery class="lg:sticky lg:top-24 lg:self-start">
      <div class="flex flex-col-reverse gap-3 sm:flex-row">
        {
          p.images.length > 1 && (
            <ul class="flex gap-2 overflow-x-auto sm:max-h-[520px] sm:w-20 sm:shrink-0 sm:flex-col sm:overflow-y-auto" aria-label="Autres photos">
              {p.images.map((img, i) => (
                <li class="shrink-0">
                  <button
                    type="button"
                    class="block size-16 overflow-hidden rounded-lg border-2 border-line bg-white aria-pressed:border-brand-700 sm:size-20"
                    data-thumb={imageUrl(img.id)}
                    data-alt={img.alt || p.name}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                    aria-label={`Photo ${i + 1}`}
                  >
                    <img src={imageUrl(img.id, 'mini')} alt="" loading="lazy" class="size-full object-contain" />
                  </button>
                </li>
              ))}
            </ul>
          )
        }
        <div class="group relative flex-1 overflow-hidden rounded-2xl bg-white ring-1 ring-line">
          {
            p.images.length > 0 ? (
              <button type="button" class="block w-full cursor-zoom-in" data-zoom aria-label="Agrandir la photo">
                <img
                  src={imageUrl(p.images[0].id)}
                  alt={p.images[0].alt || p.name}
                  width={p.images[0].width ?? undefined}
                  height={p.images[0].height ?? undefined}
                  fetchpriority="high"
                  class="aspect-square w-full object-contain transition duration-300 group-hover:scale-105"
                  data-main-image
                />
              </button>
            ) : (
              <ProductImage name={p.name} color={category.data.color} icon={category.data.icon} size="lg" eager class="aspect-square w-full transition duration-300 group-hover:scale-105" />
            )
          }
          {
            p.images.length > 0 && (
              <span class="pointer-events-none absolute bottom-3 left-3 grid size-10 place-items-center rounded-full bg-white/95 text-ink shadow">
                <Icon name="zoom" size={18} />
              </span>
            )
          }
        </div>
      </div>
      <p class="mt-2 text-center text-xs text-muted">Photo non contractuelle</p>

      <dialog class="m-auto max-h-[92vh] max-w-[92vw] rounded-2xl bg-white p-0 backdrop:bg-black/70" data-zoom-dialog aria-label="Photo agrandie">
        <form method="dialog" class="absolute right-2 top-2">
          <button class="grid size-10 place-items-center rounded-full bg-white text-brand-900 shadow" aria-label="Fermer"><Icon name="close" /></button>
        </form>
        <img src="" alt="" class="max-h-[90vh] w-auto object-contain" data-zoom-image />
      </dialog>
    </section>

    <!-- ───────── Colonne droite : achat ───────── -->
    <section aria-labelledby="titre-produit">
      {
        p.badges.length > 0 && (
          <p class="mb-2 flex flex-wrap gap-1">
            {p.badges.map((b, i) => (
              <span
                class:list={[
                  'inline-flex items-center rounded-sm px-1.5 text-xs font-extrabold leading-5',
                  i === 0 ? 'bg-accent-500 pr-3 text-brand-950 [clip-path:polygon(0_0,calc(100%-7px)_0,100%_50%,calc(100%-7px)_100%,0_100%)]' : `badge-${b}`,
                ]}
              >
                {BADGE_LABELS[b]}
              </span>
            ))}
          </p>
        )
      }
      <h1 id="titre-produit" class="text-xl font-bold leading-snug !text-ink sm:text-2xl">{p.name}</h1>
      <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
        {p.sold > 0 && <span><strong class="text-ink">{p.sold.toLocaleString('fr-FR')}</strong> vendu{p.sold > 1 ? 's' : ''}</span>}
        {p.sold > 0 && <span aria-hidden="true">·</span>}
        <span>Réf. {p.sku}</span>
        <span aria-hidden="true">·</span>
        <FavoriteButton productId={product.id} name={p.name} withLabel class="!border-0 !bg-transparent !p-0 !shadow-none" />
      </p>
      <p class="mt-2 flex flex-wrap items-center gap-x-1.5 text-sm">
        <Icon name="check" size={16} class="text-brand-600" />
        <a href={`/boutique?marque=${brand.id}`} class="font-extrabold text-brand-700 hover:underline">{brand.data.name}</a>
        <span class="text-muted">· {p.origin === 'local' ? 'Produit local' : 'Importé'} · {category.data.name}</span>
      </p>
      <p class="mt-3 text-[15px] text-muted">{p.summary}</p>

      <form class="mt-5" data-product-form data-product-id={product.id} onsubmit="return false">
        <!-- Prix par format (équivalent des paliers de prix Alibaba) -->
        <div class="rounded-2xl bg-accent-100/60 p-4">
          {
            isDevis ? (
              <p class="text-2xl font-extrabold text-ink">Prix sur devis</p>
            ) : (
              <>
                <div class="grid grid-cols-2 gap-x-4 gap-y-3 sm:grid-cols-3">
                  {p.variants.map((v) => (
                    <label for={`format-${v.id}`} class="cursor-pointer rounded-xl p-1.5 transition hover:bg-white/70" data-tier={v.id}>
                      <span class="block text-xs text-muted">{v.label}</span>
                      <span class="block text-lg font-extrabold leading-tight text-ink sm:text-xl">{formatPrice(v.price)}</span>
                      {discount(v) > 0 && (
                        <span class="block text-xs text-danger">
                          −{discount(v)} % <s class="text-muted">{formatPrice(v.compareAtPrice!)}</s>
                        </span>
                      )}
                    </label>
                  ))}
                </div>
                <p class="mt-3 flex flex-wrap items-baseline gap-x-3 border-t border-accent-500/20 pt-3">
                  <span class="text-sm text-muted">Format choisi :</span>
                  <span class="text-2xl font-extrabold text-brand-900" data-price-display>{formatPrice(defaultVariant.price)}</span>
                  <s class="text-sm text-muted" data-compare-display hidden={!defaultVariant.compareAtPrice}>
                    {defaultVariant.compareAtPrice ? formatPrice(defaultVariant.compareAtPrice) : ''}
                  </s>
                  {p.variants.length > 1 && <span class="text-xs text-muted">(de {priceRange})</span>}
                </p>
                {bestDiscount > 0 && (
                  <p class="mt-1 flex items-center gap-1 text-sm font-semibold text-danger">
                    <Icon name="tag" size={14} />Jusqu'à −{bestDiscount} % sur ce produit
                  </p>
                )}
                {hasProPrices && (
                  <p class="mt-2 inline-flex items-center gap-2 rounded-lg bg-brand-900 px-3 py-1.5 text-sm font-semibold text-white" data-pro-price hidden>
                    <span class="badge badge-populaire">Pro</span>
                    <span>Votre prix professionnel : <strong data-pro-price-value /></span>
                  </p>
                )}
              </>
            )
          }
        </div>

        <!-- Variations -->
        <fieldset class="mt-5">
          <legend class="text-sm font-bold text-ink">
            Format : <span class="font-normal" data-variant-label>{defaultVariant.label}</span>
          </legend>
          <div class="mt-2 flex flex-wrap gap-2">
            {
              p.variants.map((v) => (
                <>
                  <input
                    type="radio"
                    id={`format-${v.id}`}
                    name="variante"
                    value={v.id}
                    checked={v.id === defaultVariant.id}
                    class="peer sr-only"
                    data-price={v.price}
                    data-compare={v.compareAtPrice ?? ''}
                    data-weight={v.weightKg}
                    data-label={v.label}
                  />
                  <label
                    for={`format-${v.id}`}
                    class="cursor-pointer rounded-lg border-2 border-line bg-white px-3.5 py-2 text-sm font-semibold transition hover:border-brand-600 [input:checked+&]:border-brand-700 [input:checked+&]:bg-brand-50 [input:checked+&]:text-brand-800 [input:focus-visible+&]:outline-2 [input:focus-visible+&]:outline-accent-500"
                  >
                    {v.label}
                  </label>
                </>
              ))
            }
          </div>
        </fieldset>

        <!-- Disponibilité et quantité -->
        <div class="mt-5 flex flex-wrap items-center gap-4">
          {
            buyable && (
              <div class="flex items-center rounded-xl border border-line bg-white">
                <button type="button" class="px-4 py-2.5" data-qty-step="-1" aria-label="Diminuer la quantité"><Icon name="minus" size={16} /></button>
                <label for="quantite" class="sr-only">Quantité</label>
                <input id="quantite" type="number" min="1" max="999" value="1" inputmode="numeric" class="w-14 border-0 bg-transparent text-center font-bold focus:outline-none" />
                <button type="button" class="px-4 py-2.5" data-qty-step="1" aria-label="Augmenter la quantité"><Icon name="plus" size={16} /></button>
              </div>
            )
          }
          <p class="flex items-center gap-2 text-sm">
            <span class:list={['inline-block size-2 rounded-full', statusDot]} />
            <strong>{STATUS_LABELS[p.status]}</strong>
            <span class="text-muted">{statusNote}</span>
          </p>
        </div>

        <!-- Livraison -->
        <div class="mt-5 space-y-2 rounded-2xl border border-line bg-white p-4 text-sm">
          <p class="flex items-start gap-2">
            <Icon name="truck" size={18} class="mt-0.5 shrink-0 text-brand-600" />
            <span>
              <strong>Livraison</strong>
              {cheapestDelivery && <> dès {formatPrice(cheapestDelivery.fee)}</>}
              {settings.delivery.freeThreshold > 0 && <span class="text-muted"> · offerte à Lomé dès {formatPrice(settings.delivery.freeThreshold)}</span>}
              <span class="block text-muted">Délai indicatif : {leadTime} · Poids : <span data-weight-display>{defaultVariant.weightKg} kg</span></span>
            </span>
          </p>
          {
            pickup && (
              <p class="flex items-start gap-2">
                <Icon name="store" size={18} class="mt-0.5 shrink-0 text-brand-600" />
                <span><strong>Retrait gratuit</strong> au dépôt <span class="text-muted">· {pickup.delay}</span></span>
              </p>
            )
          }
        </div>

        <!-- Protections -->
        <div class="mt-3 rounded-2xl border border-line bg-white p-4 text-sm">
          <p class="font-bold">Protections pour cette commande</p>
          <ul class="mt-2 space-y-1.5 text-muted">
            <li class="flex gap-2"><Icon name="shield" size={16} class="mt-0.5 shrink-0 text-brand-600" />Paiement sécurisé : Mobile Money, carte ou à la livraison</li>
            <li class="flex gap-2"><Icon name="refresh" size={16} class="mt-0.5 shrink-0 text-brand-600" />Remplacement ou remboursement si le produit n'est pas conforme</li>
            <li class="flex gap-2"><Icon name="box" size={16} class="mt-0.5 shrink-0 text-brand-600" />Suivi de commande de la préparation à la livraison</li>
          </ul>
        </div>

        <!-- Actions -->
        <div class="mt-5 grid gap-2 sm:grid-cols-2">
          {
            buyable ? (
              <>
                <button
                  type="button"
                  class="btn btn-accent !py-3.5 !text-base"
                  data-add-to-cart={cartPayload(product, category.data.color)}
                  data-variant-select="variante"
                  data-qty-input="quantite"
                  data-buy-now
                >
                  Commander maintenant
                </button>
                <button
                  type="button"
                  class="btn btn-primary !py-3.5 !text-base"
                  data-add-to-cart={cartPayload(product, category.data.color)}
                  data-variant-select="variante"
                  data-qty-input="quantite"
                >
                  <Icon name="cart" size={20} />Ajouter au panier
                </button>
              </>
            ) : (
              <a href={devisHref} class="btn btn-primary !py-3.5 !text-base sm:col-span-2">Demander un devis</a>
            )
          }
          <a href={buyable ? devisHref : `${links.whatsappHref}?text=${whatsappText}`} class="btn btn-secondary" target={buyable ? undefined : '_blank'} rel={buyable ? undefined : 'noopener'}>
            {buyable ? 'Prix pro / gros volume' : 'Poser une question'}
          </a>
          {
            buyable && (
              <a href={`${links.whatsappHref}?text=${whatsappText}`} target="_blank" rel="noopener" class="btn btn-secondary">
                <Icon name="whatsapp" size={18} />Discuter sur WhatsApp
              </a>
            )
          }
        </div>
      </form>
    </section>
  </div>

  <!-- ───────── Détails ───────── -->
  <section class="border-t border-line bg-white">
    <div class="container-page py-10">
      <nav aria-label="Sections de la fiche" class="flex gap-1 overflow-x-auto border-b border-line text-sm font-semibold">
        <a href="#attributs" class="whitespace-nowrap border-b-2 border-brand-700 px-4 py-2.5 text-brand-900">Attributs</a>
        <a href="#livraison" class="whitespace-nowrap border-b-2 border-transparent px-4 py-2.5 text-muted hover:text-brand-700">Emballage & livraison</a>
        <a href="#description" class="whitespace-nowrap border-b-2 border-transparent px-4 py-2.5 text-muted hover:text-brand-700">Description</a>
      </nav>

      <h2 id="attributs" class="mt-8 scroll-mt-28 text-xl">Attributs clés</h2>
      <dl class="mt-4 grid overflow-hidden rounded-xl border border-line text-sm sm:grid-cols-2">
        {
          attributes.map(([label, value]) => (
            <div class="grid grid-cols-[40%_60%] border-b border-line sm:odd:border-r">
              <dt class="bg-canvas px-4 py-3 text-muted">{label}</dt>
              <dd class="px-4 py-3 font-semibold">{value}</dd>
            </div>
          ))
        }
      </dl>

      <h2 id="livraison" class="mt-10 scroll-mt-28 text-xl">Emballage & livraison</h2>
      <div class="mt-4 overflow-x-auto rounded-xl border border-line">
        <table class="w-full min-w-[480px] text-left text-sm">
          <thead class="bg-canvas text-muted">
            <tr><th class="px-4 py-3 font-semibold">Format</th><th class="px-4 py-3 font-semibold">Unité</th><th class="px-4 py-3 font-semibold">Poids</th><th class="px-4 py-3 text-right font-semibold">Prix</th></tr>
          </thead>
          <tbody class="divide-y divide-line">
            {
              p.variants.map((v) => (
                <tr>
                  <td class="px-4 py-3 font-semibold">{v.label}</td>
                  <td class="px-4 py-3 capitalize">{v.unit}</td>
                  <td class="px-4 py-3">{v.weightKg} kg</td>
                  <td class="px-4 py-3 text-right font-semibold">{isDevis ? 'Sur devis' : formatPrice(v.price)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-sm text-muted">Délai indicatif : {leadTime}. Zones et frais détaillés dans <a href="/legal/livraison-retours" class="font-semibold underline">Livraison & retours</a>.</p>

      <h2 id="description" class="mt-10 scroll-mt-28 text-xl">Description</h2>
      <div class="mt-3 max-w-3xl space-y-3 leading-relaxed text-ink">
        {p.description.split(/\n{2,}/).map((para) => <p>{para}</p>)}
      </div>

      <div class="mt-8 flex flex-col gap-3 rounded-2xl bg-brand-900 p-6 text-white sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="font-bold">Vous achetez en volume ?</p>
          <p class="text-sm text-brand-200">Commerçants, restaurants, entreprises : obtenez un prix adapté à vos quantités.</p>
        </div>
        <a href={devisHref} class="btn btn-accent shrink-0">Demander un prix pro</a>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section !pt-10">
        <div class="container-page">
          <h2 class="text-2xl">Produits similaires</h2>
          <div class="mt-6 grid grid-cols-2 gap-2.5 sm:gap-4 md:grid-cols-3 lg:grid-cols-5">
            {related.map((r) => <ProductCard product={r} category={categoryOf(r)} brand={brandOf(r)} />)}
          </div>
        </div>
      </section>
    )
  }
</Layout>

<script>
  import { formatPrice } from '../../lib/format';
  import { track } from '../../scripts/analytics';
  import { SYNC_STATE_KEY } from '../../scripts/cart';

  const form = document.querySelector<HTMLFormElement>('[data-product-form]')!;
  const priceEl = document.querySelector<HTMLElement>('[data-price-display]');
  const compareEl = document.querySelector<HTMLElement>('[data-compare-display]');
  const weightEl = document.querySelector<HTMLElement>('[data-weight-display]');
  const labelEl = document.querySelector<HTMLElement>('[data-variant-label]');
  const proEl = document.querySelector<HTMLElement>('[data-pro-price]');
  const qty = document.getElementById('quantite') as HTMLInputElement | null;
  const productId = form.dataset.productId!;
  let proPrices: Record<string, number> | null = null;

  const selectedVariant = () => form.querySelector<HTMLInputElement>('input[name="variante"]:checked')!;

  function renderProPrice() {
    if (!proEl) return;
    const price = proPrices?.[selectedVariant().value];
    proEl.hidden = !price;
    if (price) proEl.querySelector('[data-pro-price-value]')!.textContent = formatPrice(price);
  }

  // Le palier de prix du format choisi est mis en avant.
  function renderSelection() {
    const input = selectedVariant();
    if (priceEl) priceEl.textContent = formatPrice(Number(input.dataset.price));
    if (compareEl) {
      compareEl.hidden = !input.dataset.compare;
      compareEl.textContent = input.dataset.compare ? formatPrice(Number(input.dataset.compare)) : '';
    }
    if (weightEl) weightEl.textContent = `${input.dataset.weight} kg`;
    if (labelEl) labelEl.textContent = input.dataset.label ?? '';
    document.querySelectorAll<HTMLElement>('[data-tier]').forEach((t) => {
      const on = t.dataset.tier === input.value;
      t.classList.toggle('bg-white', on);
      t.classList.toggle('ring-2', on);
      t.classList.toggle('ring-brand-700', on);
    });
    renderProPrice();
  }

  form.addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement).name === 'variante') renderSelection();
  });
  renderSelection();

  form.querySelectorAll<HTMLButtonElement>('[data-qty-step]').forEach((b) =>
    b.addEventListener('click', () => {
      if (!qty) return;
      qty.value = String(Math.min(999, Math.max(1, (Number(qty.value) || 1) + Number(b.dataset.qtyStep))));
    }),
  );

  // « Commander maintenant » : l'article est ajouté au panier (script du panier), puis direction la commande.
  form.querySelector('[data-buy-now]')?.addEventListener('click', () => setTimeout(() => (location.href = '/commande'), 150));

  // Prix professionnels : demandés seulement si le produit en a et que le visiteur a peut-être un compte.
  let visitor = false;
  try {
    visitor = sessionStorage.getItem(SYNC_STATE_KEY) === 'visiteur';
  } catch {}
  if (proEl && !visitor) {
    fetch(`/api/pro-prices?ids=${encodeURIComponent(productId)}`)
      .then((res) => (res.ok ? res.json() : null))
      .then((data: { prices: Record<string, Record<string, number>> } | null) => {
        proPrices = data?.prices[productId] ?? null;
        renderProPrice();
      })
      .catch(() => {});
  }

  // Galerie : vignettes et agrandissement.
  const main = document.querySelector<HTMLImageElement>('[data-main-image]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-zoom-dialog]')!;
  const zoomImage = dialog.querySelector<HTMLImageElement>('[data-zoom-image]')!;
  document.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((b) => {
    const show = () => {
      if (!main) return;
      main.src = b.dataset.thumb!;
      main.alt = b.dataset.alt!;
      document.querySelectorAll('[data-thumb]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    };
    b.addEventListener('click', show);
    b.addEventListener('mouseenter', show);
  });
  document.querySelector('[data-zoom]')?.addEventListener('click', () => {
    if (!main) return;
    zoomImage.src = main.src;
    zoomImage.alt = main.alt;
    dialog.showModal();
  });
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());

  track('view_item', { item_id: productId });
</script>

---
import Layout from '../../layouts/Layout.astro';
import FavoriteButton from '../../components/FavoriteButton.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Icon from '../../components/ui/Icon.astro';
import ProductImage from '../../components/ui/ProductImage.astro';
import { canBuyOnline, cartPayload, getCatalog, lowestVariant, productUrl, type Product } from '../../lib/catalog';
import { BADGE_LABELS, STATUS_LABELS, formatPrice } from '../../lib/format';
import { imageUrl } from '../../lib/media';
import { findRedirect } from '../../lib/redirects';
import { activeZones, contactLinks, getSettings } from '../../lib/settings';
import { SITE } from '../../data/site';

const { products, categoryOf, brandOf } = await getCatalog();
const product = products.find((x) => x.slug === Astro.params.slug);
if (!product) {
  // Adresse modifiée ou produit retiré : redirection si elle a été prévue, sinon page 404.
  const redirect = await findRedirect(Astro.url.pathname);
  if (redirect) return Astro.redirect(redirect.to, redirect.status as 301);
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const settings = await getSettings();
const links = contactLinks(settings.contact);
const p = product.data;
const category = categoryOf(product);
const brand = brandOf(product);
const defaultVariant = lowestVariant(product);
const buyable = canBuyOnline(product);
const hasProPrices = p.variants.some((v) => v.proPrice && v.proPrice < v.price);
const cheapestDelivery = activeZones(settings).filter((z) => z.fee > 0).sort((a, b) => a.fee - b.fee)[0];

const related = p.related
  .map((id) => products.find((x) => x.id === id))
  .filter((x): x is Product => !!x)
  .concat(products.filter((x) => x.id !== product.id && x.data.category.id === category.id && !p.related.includes(x.id)))
  .slice(0, 4);

const availability = {
  disponible: 'https://schema.org/InStock',
  'sur-commande': 'https://schema.org/PreOrder',
  indisponible: 'https://schema.org/OutOfStock',
  devis: 'https://schema.org/LimitedAvailability',
}[p.status];

const url = new URL(productUrl(product), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  sku: p.sku,
  description: p.summary,
  category: category.data.name,
  brand: { '@type': 'Brand', name: brand.data.name },
  image: p.images.map((i) => new URL(imageUrl(i.id), Astro.site).href),
  offers: p.variants.map((v) => ({
    '@type': 'Offer',
    sku: `${p.sku}-${v.id}`,
    name: v.label,
    price: v.price,
    priceCurrency: SITE.currency,
    availability,
    url,
  })),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Boutique', item: new URL('/boutique', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: category.data.name, item: new URL(`/boutique?categorie=${category.id}`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: p.name, item: url },
  ],
};

const whatsappText = encodeURIComponent(`Bonjour AfriSime, je souhaite des informations sur : ${p.name} (${p.sku}).`);
const statusStyle = {
  disponible: 'bg-brand-50 text-brand-700 border-brand-200',
  'sur-commande': 'bg-warning-50 text-warning border-warning/20',
  indisponible: 'bg-danger-50 text-danger border-danger/20',
  devis: 'bg-info-50 text-info border-info/20',
}[p.status];
const statusNote = {
  disponible: p.stock !== null && p.stock > 0 && p.stock <= 10 ? `Plus que ${p.stock} en stock.` : 'En stock, prêt à être livré.',
  'sur-commande': 'Commandable en ligne : livraison sous 3 à 7 jours après confirmation.',
  indisponible: 'Réassort en cours. Contactez-nous pour connaître la date de retour.',
  devis: 'Ce produit est vendu sur devis selon les volumes.',
}[p.status];
const leadTime = p.leadTime || (p.status === 'sur-commande' ? '3 à 7 jours' : 'Sous 24 h à Lomé centre');
const devisHref = `/b2b?produit=${encodeURIComponent(p.name)}#devis`;
---

<Layout
  title={p.seoTitle || `${p.name} – ${brand.data.name}`}
  description={p.seoDescription || `${p.summary} Réf. ${p.sku}. À partir de ${formatPrice(defaultVariant.price)}.`}
  imageId={p.images[0]?.id}
  jsonLd={[jsonLd, breadcrumbLd]}
>
  <div class="container-page py-6">
    <Breadcrumbs items={[{ label: 'Boutique', href: '/boutique' }, { label: category.data.name, href: `/boutique?categorie=${category.id}` }, { label: p.name }]} />
  </div>

  <section class="container-page grid gap-8 pb-12 lg:grid-cols-2 lg:gap-14">
    <!-- Galerie -->
    <div data-gallery>
      <div class="card group relative overflow-hidden">
        {
          p.images.length > 0 ? (
            <button type="button" class="block w-full cursor-zoom-in" data-zoom aria-label="Agrandir la photo">
              <img
                src={imageUrl(p.images[0].id)}
                alt={p.images[0].alt || p.name}
                width={p.images[0].width ?? undefined}
                height={p.images[0].height ?? undefined}
                fetchpriority="high"
                class="aspect-square w-full bg-white object-contain"
                data-main-image
              />
              <span class="absolute bottom-3 right-3 grid size-10 place-items-center rounded-full bg-white/90 text-brand-900 shadow">
                <Icon name="zoom" size={18} />
              </span>
            </button>
          ) : (
            <ProductImage name={p.name} color={category.data.color} icon={category.data.icon} size="lg" eager class="aspect-square w-full" />
          )
        }
        <div class="pointer-events-none absolute left-4 top-4 flex flex-wrap gap-1.5">
          {p.badges.map((b) => <span class={`badge badge-${b}`}>{BADGE_LABELS[b]}</span>)}
        </div>
      </div>
      {
        p.images.length > 1 && (
          <ul class="mt-3 grid grid-cols-5 gap-2" aria-label="Autres photos">
            {p.images.map((img, i) => (
              <li>
                <button
                  type="button"
                  class="card block w-full overflow-hidden aria-pressed:border-brand-700 aria-pressed:ring-2 aria-pressed:ring-brand-200"
                  data-thumb={imageUrl(img.id)}
                  data-alt={img.alt || p.name}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  aria-label={`Photo ${i + 1}`}
                >
                  <img src={imageUrl(img.id, 'mini')} alt="" loading="lazy" class="aspect-square w-full bg-white object-contain" />
                </button>
              </li>
            ))}
          </ul>
        )
      }
      <p class="mt-2 text-center text-xs text-muted">Photo non contractuelle</p>

      <dialog class="m-auto max-h-[92vh] max-w-[92vw] rounded-2xl bg-white p-0 backdrop:bg-black/70" data-zoom-dialog aria-label="Photo agrandie">
        <form method="dialog" class="absolute right-2 top-2">
          <button class="grid size-10 place-items-center rounded-full bg-white text-brand-900 shadow" aria-label="Fermer"><Icon name="close" /></button>
        </form>
        <img src="" alt="" class="max-h-[90vh] w-auto object-contain" data-zoom-image />
      </dialog>
    </div>

    <!-- Achat -->
    <div>
      <div class="flex items-start justify-between gap-3">
        <p class="text-sm font-semibold text-muted">
          <a href={`/boutique?marque=${brand.id}`} class="hover:text-brand-600">{brand.data.name}</a> · Réf. {p.sku}
        </p>
        <FavoriteButton productId={product.id} name={p.name} withLabel />
      </div>
      <h1 class="mt-2 text-3xl sm:text-4xl">{p.name}</h1>
      <p class="mt-3 text-lg text-muted">{p.summary}</p>

      <div class={`mt-5 rounded-xl border px-4 py-3 text-sm ${statusStyle}`}>
        <strong>{STATUS_LABELS[p.status]}</strong> — {statusNote}
      </div>

      <form class="mt-6" data-product-form data-product-id={product.id} onsubmit="return false">
        <fieldset>
          <legend class="label">Format</legend>
          <div class="grid gap-2 sm:grid-cols-2">
            {
              p.variants.map((v) => (
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="variante"
                    value={v.id}
                    checked={v.id === defaultVariant.id}
                    class="peer sr-only"
                    data-price={v.price}
                    data-compare={v.compareAtPrice ?? ''}
                    data-weight={v.weightKg}
                  />
                  <span class="flex items-center justify-between gap-2 rounded-xl border-2 border-line px-4 py-3 text-sm transition peer-checked:border-brand-700 peer-checked:bg-brand-50 peer-focus-visible:outline-2 peer-focus-visible:outline-accent-500">
                    <span class="font-semibold">{v.label}</span>
                    {p.status !== 'devis' && <span class="font-extrabold text-brand-900">{formatPrice(v.price)}</span>}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        {
          p.status !== 'devis' && (
            <div class="mt-6">
              <p class="flex items-baseline gap-3">
                <span class="text-4xl font-extrabold text-brand-900" data-price-display>{formatPrice(defaultVariant.price)}</span>
                <s class="text-lg text-muted" data-compare-display hidden={!defaultVariant.compareAtPrice}>
                  {defaultVariant.compareAtPrice ? formatPrice(defaultVariant.compareAtPrice) : ''}
                </s>
              </p>
              {hasProPrices && (
                <p class="mt-2 inline-flex items-center gap-2 rounded-lg bg-brand-900 px-3 py-1.5 text-sm font-semibold text-white" data-pro-price hidden>
                  <span class="badge badge-populaire">Pro</span>
                  <span>Votre prix professionnel : <strong data-pro-price-value /></span>
                </p>
              )}
            </div>
          )
        }

        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          {
            buyable && (
              <>
                <div class="flex items-center rounded-xl border border-line bg-white">
                  <button type="button" class="px-4 py-3" data-qty-step="-1" aria-label="Diminuer la quantité"><Icon name="minus" size={16} /></button>
                  <label for="quantite" class="sr-only">Quantité</label>
                  <input id="quantite" type="number" min="1" max="999" value="1" inputmode="numeric" class="w-14 border-0 bg-transparent text-center font-bold focus:outline-none" />
                  <button type="button" class="px-4 py-3" data-qty-step="1" aria-label="Augmenter la quantité"><Icon name="plus" size={16} /></button>
                </div>
                <button
                  type="button"
                  class="btn btn-primary flex-1 !py-4 !text-base"
                  data-add-to-cart={cartPayload(product, category.data.color)}
                  data-variant-select="variante"
                  data-qty-input="quantite"
                >
                  <Icon name="cart" size={20} />Ajouter au panier
                </button>
              </>
            )
          }
          {
            !buyable && (
              <a href={devisHref} class="btn btn-primary flex-1 !py-4 !text-base">
                Demander un devis
              </a>
            )
          }
        </div>
        <div class="mt-3 flex flex-col gap-2 sm:flex-row">
          <a href={devisHref} class="btn btn-secondary flex-1" hidden={!buyable}>Prix pro / gros volume</a>
          <a href={`${links.whatsappHref}?text=${whatsappText}`} target="_blank" rel="noopener" class="btn btn-ghost flex-1">
            <Icon name="whatsapp" size={18} />Poser une question
          </a>
        </div>
      </form>

      <ul class="mt-8 grid gap-3 text-sm sm:grid-cols-3">
        {cheapestDelivery && <li class="flex items-center gap-2"><Icon name="truck" size={18} class="text-brand-600" />Livraison dès {formatPrice(cheapestDelivery.fee)}</li>}
        <li class="flex items-center gap-2"><Icon name="store" size={18} class="text-brand-600" />Retrait gratuit au dépôt</li>
        <li class="flex items-center gap-2"><Icon name="shield" size={18} class="text-brand-600" />Paiement sécurisé</li>
      </ul>
    </div>
  </section>

  <!-- Détails -->
  <section class="border-t border-line bg-white">
    <div class="container-page grid gap-10 py-12 lg:grid-cols-[2fr_1fr]">
      <div>
        <h2 class="text-2xl">Description</h2>
        {p.description.split(/\n{2,}/).map((para) => <p class="mt-3 leading-relaxed text-ink">{para}</p>)}
        <h2 class="mt-10 text-2xl">Caractéristiques</h2>
        <dl class="mt-4 divide-y divide-line rounded-2xl border border-line">
          <div class="grid grid-cols-2 gap-4 px-4 py-3 text-sm"><dt class="text-muted">Référence</dt><dd class="font-semibold">{p.sku}</dd></div>
          <div class="grid grid-cols-2 gap-4 px-4 py-3 text-sm"><dt class="text-muted">Catégorie</dt><dd class="font-semibold">{category.data.name}</dd></div>
          <div class="grid grid-cols-2 gap-4 px-4 py-3 text-sm"><dt class="text-muted">Marque</dt><dd class="font-semibold">{brand.data.name}</dd></div>
          <div class="grid grid-cols-2 gap-4 px-4 py-3 text-sm"><dt class="text-muted">Origine</dt><dd class="font-semibold">{p.origin === 'local' ? 'Produit local' : 'Importé'}</dd></div>
          {p.features.map((f) => (
            <div class="grid grid-cols-2 gap-4 px-4 py-3 text-sm"><dt class="text-muted">{f.label}</dt><dd class="font-semibold">{f.value}</dd></div>
          ))}
        </dl>
      </div>
      <aside>
        <h2 class="text-2xl">Logistique</h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="card p-4">
            <dt class="text-muted">Poids du format choisi</dt>
            <dd class="mt-1 font-bold" data-weight-display>{defaultVariant.weightKg} kg</dd>
          </div>
          <div class="card p-4">
            <dt class="text-muted">Délai indicatif</dt>
            <dd class="mt-1 font-bold">{leadTime}</dd>
          </div>
        </dl>
        <div class="mt-4 rounded-2xl bg-brand-900 p-5 text-white">
          <p class="font-bold">Vous achetez en volume ?</p>
          <p class="mt-1 text-sm text-brand-200">Commerçants, restaurants, entreprises : obtenez un prix adapté à vos quantités.</p>
          <a href={devisHref} class="btn btn-accent btn-sm mt-4">Demander un prix pro</a>
        </div>
      </aside>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section !pt-12">
        <div class="container-page">
          <h2 class="text-2xl">Vous aimerez aussi</h2>
          <div class="mt-6 grid grid-cols-1 gap-4 min-[420px]:grid-cols-2 lg:grid-cols-4">
            {related.map((r) => <ProductCard product={r} category={categoryOf(r)} brand={brandOf(r)} />)}
          </div>
        </div>
      </section>
    )
  }
</Layout>

<script>
  import { formatPrice } from '../../lib/format';
  import { track } from '../../scripts/analytics';
  import { SYNC_STATE_KEY } from '../../scripts/cart';

  const form = document.querySelector<HTMLFormElement>('[data-product-form]')!;
  const priceEl = document.querySelector<HTMLElement>('[data-price-display]');
  const compareEl = document.querySelector<HTMLElement>('[data-compare-display]');
  const weightEl = document.querySelector<HTMLElement>('[data-weight-display]');
  const proEl = document.querySelector<HTMLElement>('[data-pro-price]');
  const qty = document.getElementById('quantite') as HTMLInputElement | null;
  const productId = form.dataset.productId!;
  let proPrices: Record<string, number> | null = null;

  const selectedVariant = () => form.querySelector<HTMLInputElement>('input[name="variante"]:checked')!;

  function renderProPrice() {
    if (!proEl) return;
    const price = proPrices?.[selectedVariant().value];
    proEl.hidden = !price;
    if (price) proEl.querySelector('[data-pro-price-value]')!.textContent = formatPrice(price);
  }

  form.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.name !== 'variante') return;
    if (priceEl) priceEl.textContent = formatPrice(Number(input.dataset.price));
    if (compareEl) {
      compareEl.hidden = !input.dataset.compare;
      compareEl.textContent = input.dataset.compare ? formatPrice(Number(input.dataset.compare)) : '';
    }
    if (weightEl) weightEl.textContent = `${input.dataset.weight} kg`;
    renderProPrice();
  });

  form.querySelectorAll<HTMLButtonElement>('[data-qty-step]').forEach((b) =>
    b.addEventListener('click', () => {
      if (!qty) return;
      qty.value = String(Math.min(999, Math.max(1, (Number(qty.value) || 1) + Number(b.dataset.qtyStep))));
    }),
  );

  // Prix professionnels : demandés seulement si le produit en a et que le visiteur a peut-être un compte.
  let visitor = false;
  try {
    visitor = sessionStorage.getItem(SYNC_STATE_KEY) === 'visiteur';
  } catch {}
  if (proEl && !visitor) {
    fetch(`/api/pro-prices?ids=${encodeURIComponent(productId)}`)
      .then((res) => (res.ok ? res.json() : null))
      .then((data: { prices: Record<string, Record<string, number>> } | null) => {
        proPrices = data?.prices[productId] ?? null;
        renderProPrice();
      })
      .catch(() => {});
  }

  // Galerie : vignettes et agrandissement.
  const main = document.querySelector<HTMLImageElement>('[data-main-image]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-zoom-dialog]')!;
  const zoomImage = dialog.querySelector<HTMLImageElement>('[data-zoom-image]')!;
  document.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((b) =>
    b.addEventListener('click', () => {
      if (!main) return;
      main.src = b.dataset.thumb!;
      main.alt = b.dataset.alt!;
      document.querySelectorAll('[data-thumb]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    }),
  );
  document.querySelector('[data-zoom]')?.addEventListener('click', () => {
    if (!main) return;
    zoomImage.src = main.src;
    zoomImage.alt = main.alt;
    dialog.showModal();
  });
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());

  track('view_item', { item_id: productId });
</script>

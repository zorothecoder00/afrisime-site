---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Icon from '../../components/ui/Icon.astro';
import { getCatalog, lowestVariant } from '../../lib/catalog';
import { STATUS_LABELS } from '../../lib/format';

const { products, categories, brands, categoryOf, brandOf } = await getCatalog();
const sorted = [...products].sort((a, b) => b.data.popularity - a.data.popularity);

const packagings = [...new Set(products.flatMap((p) => p.data.variants.map((v) => v.unit)))].sort();
const countBy = (fn: (p: (typeof products)[number]) => boolean) => products.filter(fn).length;
---

<Layout
  title="Boutique"
  description="Catalogue AfriSime : riz, huiles, farines, boissons, produits locaux et entretien. Prix détail et gros, livraison à Lomé et au Togo."
>
  <section class="border-b border-line bg-brand-50">
    <div class="container-page py-8">
      <Breadcrumbs items={[{ label: 'Boutique' }]} />
      <h1 class="mt-4 text-3xl sm:text-4xl" data-title>Boutique</h1>
      <form class="relative mt-5 max-w-2xl" role="search" data-search-form>
        <label for="q" class="sr-only">Rechercher dans le catalogue</label>
        <input id="q" name="q" type="search" class="input !rounded-full !py-3.5 pl-12 text-base" placeholder="Riz, huile 5 L, AFS-CER-001…" autocomplete="off" />
        <Icon name="search" class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-muted" />
      </form>
    </div>
  </section>

  <div class="container-page grid gap-8 py-8 lg:grid-cols-[260px_1fr]">
    <!-- Filtres -->
    <aside>
      <details class="group lg:!block" data-filters-panel open>
        <summary class="btn btn-secondary w-full list-none lg:hidden">
          <Icon name="filter" size={18} />Filtres <span class="badge badge-b2b" data-active-count hidden></span>
        </summary>
        <form class="mt-4 space-y-6 lg:mt-0" data-filters>
          <fieldset>
            <legend class="text-sm font-extrabold uppercase tracking-wide text-brand-900">Catégories</legend>
            <ul class="mt-3 space-y-2">
              {
                categories.map((c) => (
                  <li>
                    <label class="flex items-center gap-2 text-sm">
                      <input type="checkbox" name="categorie" value={c.id} class="size-4 accent-brand-700" />
                      <span class="flex-1">{c.data.name}</span>
                      <span class="text-xs text-muted">{countBy((p) => p.data.category.id === c.id)}</span>
                    </label>
                  </li>
                ))
              }
            </ul>
          </fieldset>

          <fieldset>
            <legend class="text-sm font-extrabold uppercase tracking-wide text-brand-900">Marques</legend>
            <ul class="mt-3 space-y-2">
              {
                brands.map((b) => (
                  <li>
                    <label class="flex items-center gap-2 text-sm">
                      <input type="checkbox" name="marque" value={b.id} class="size-4 accent-brand-700" />
                      <span class="flex-1">{b.data.name}</span>
                    </label>
                  </li>
                ))
              }
            </ul>
          </fieldset>

          <fieldset>
            <legend class="text-sm font-extrabold uppercase tracking-wide text-brand-900">Prix (FCFA)</legend>
            <div class="mt-3 flex items-center gap-2">
              <label class="sr-only" for="prix-min">Prix minimum</label>
              <input id="prix-min" name="prixMin" type="number" min="0" step="100" inputmode="numeric" placeholder="Min" class="input !py-2" />
              <span aria-hidden="true">–</span>
              <label class="sr-only" for="prix-max">Prix maximum</label>
              <input id="prix-max" name="prixMax" type="number" min="0" step="100" inputmode="numeric" placeholder="Max" class="input !py-2" />
            </div>
          </fieldset>

          <fieldset>
            <legend class="text-sm font-extrabold uppercase tracking-wide text-brand-900">Disponibilité</legend>
            <ul class="mt-3 space-y-2">
              {
                Object.entries(STATUS_LABELS).map(([id, label]) => (
                  <li>
                    <label class="flex items-center gap-2 text-sm">
                      <input type="checkbox" name="dispo" value={id} class="size-4 accent-brand-700" />
                      {label}
                    </label>
                  </li>
                ))
              }
            </ul>
          </fieldset>

          <fieldset>
            <legend class="text-sm font-extrabold uppercase tracking-wide text-brand-900">Conditionnement</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {
                packagings.map((u) => (
                  <label class="cursor-pointer">
                    <input type="checkbox" name="format" value={u} class="peer sr-only" />
                    <span class="inline-block rounded-full border border-line px-3 py-1 text-xs font-semibold capitalize peer-checked:border-brand-700 peer-checked:bg-brand-700 peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-accent-500">
                      {u}
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset>
            <legend class="text-sm font-extrabold uppercase tracking-wide text-brand-900">Origine</legend>
            <ul class="mt-3 space-y-2">
              <li><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="origine" value="local" class="size-4 accent-brand-700" />Produit local</label></li>
              <li><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="origine" value="importe" class="size-4 accent-brand-700" />Importé</label></li>
            </ul>
          </fieldset>

          <fieldset>
            <legend class="text-sm font-extrabold uppercase tracking-wide text-brand-900">Offres</legend>
            <ul class="mt-3 space-y-2">
              <li><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="badge" value="promotion" class="size-4 accent-brand-700" />En promotion</label></li>
              <li><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="badge" value="nouveau" class="size-4 accent-brand-700" />Nouveautés</label></li>
              <li><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="badge" value="b2b" class="size-4 accent-brand-700" />Formats pro (B2B)</label></li>
            </ul>
          </fieldset>

          <button type="reset" class="btn btn-ghost btn-sm w-full">Réinitialiser les filtres</button>
        </form>
      </details>
    </aside>

    <!-- Résultats -->
    <section aria-labelledby="resultats">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p id="resultats" class="text-sm text-muted" aria-live="polite" data-result-count>{products.length} produits</p>
        <label class="flex items-center gap-2 text-sm">
          <span class="font-semibold">Trier par</span>
          <select name="tri" class="input !w-auto !py-2" data-sort>
            <option value="pertinence">Pertinence</option>
            <option value="popularite">Popularité</option>
            <option value="nouveautes">Nouveautés</option>
            <option value="prix-asc">Prix croissant</option>
            <option value="prix-desc">Prix décroissant</option>
          </select>
        </label>
      </div>

      <ul class="mt-5 grid grid-cols-2 gap-2.5 sm:gap-4 xl:grid-cols-3" data-grid>
        {
          sorted.map((p) => {
            const cat = categoryOf(p);
            const brand = brandOf(p);
            return (
              <li
                data-product
                data-search={`${p.data.name} ${brand.data.name} ${cat.data.name} ${p.data.sku} ${p.data.summary} ${p.data.variants.map((v) => v.label).join(' ')}`}
                data-name={p.data.name}
                data-categorie={cat.id}
                data-marque={brand.id}
                data-price={lowestVariant(p).price}
                data-dispo={p.data.status}
                data-badge={p.data.badges.join(' ')}
                data-format={p.data.variants.map((v) => v.unit).join(' ')}
                data-origine={p.data.origin}
                data-popularity={p.data.popularity}
                data-created={p.data.createdAt.getTime()}
              >
                <ProductCard product={p} category={cat} brand={brand} />
              </li>
            );
          })
        }
      </ul>

      <!-- État vide -->
      <div class="card mt-5 p-10 text-center" data-empty hidden>
        <Icon name="search" size={40} class="mx-auto text-muted" />
        <h2 class="mt-4 text-xl">Aucun produit ne correspond</h2>
        <p class="mx-auto mt-2 max-w-md text-sm text-muted">
          Vérifiez l'orthographe, retirez des filtres, ou dites-nous ce que vous cherchez : nous pouvons souvent le commander pour vous.
        </p>
        <div class="mt-6 flex flex-col justify-center gap-2 sm:flex-row">
          <button type="button" class="btn btn-secondary" data-clear>Effacer la recherche et les filtres</button>
          <a href="/contact?sujet=produit" class="btn btn-primary" data-ask-product>Demander ce produit</a>
        </div>
      </div>

      <nav aria-label="Pagination" class="mt-8 flex flex-wrap justify-center gap-2" data-pagination></nav>
    </section>
  </div>
</Layout>

<script>
  import { searchScore } from '../../lib/search';
  import { track } from '../../scripts/analytics';

  const PAGE_SIZE = 9;
  const MULTI = ['categorie', 'marque', 'dispo', 'format', 'origine', 'badge'] as const;

  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const items = [...grid.querySelectorAll<HTMLElement>('[data-product]')];
  const filtersForm = document.querySelector<HTMLFormElement>('[data-filters]')!;
  const searchForm = document.querySelector<HTMLFormElement>('[data-search-form]')!;
  const searchInput = searchForm.querySelector<HTMLInputElement>('input[name="q"]')!;
  const sortSelect = document.querySelector<HTMLSelectElement>('[data-sort]')!;
  const countEl = document.querySelector<HTMLElement>('[data-result-count]')!;
  const emptyEl = document.querySelector<HTMLElement>('[data-empty]')!;
  const pager = document.querySelector<HTMLElement>('[data-pagination]')!;
  const titleEl = document.querySelector<HTMLElement>('[data-title]')!;
  const activeCount = document.querySelector<HTMLElement>('[data-active-count]')!;
  const panel = document.querySelector<HTMLDetailsElement>('[data-filters-panel]')!;

  // Sur mobile, les filtres sont repliés par défaut.
  if (window.matchMedia('(max-width: 1023px)').matches) panel.open = false;

  function readState() {
    const params = new URLSearchParams(location.search);
    return {
      q: params.get('q') ?? '',
      sort: params.get('tri') ?? (params.get('q') ? 'pertinence' : 'popularite'),
      page: Math.max(1, Number(params.get('page')) || 1),
      prixMin: params.get('prixMin') ?? '',
      prixMax: params.get('prixMax') ?? '',
      multi: Object.fromEntries(MULTI.map((k) => [k, params.getAll(k)])) as Record<(typeof MULTI)[number], string[]>,
    };
  }

  function writeState(page = 1) {
    const params = new URLSearchParams();
    if (searchInput.value.trim()) params.set('q', searchInput.value.trim());
    const data = new FormData(filtersForm);
    for (const key of MULTI) data.getAll(key).forEach((v) => params.append(key, String(v)));
    for (const key of ['prixMin', 'prixMax']) if (data.get(key)) params.set(key, String(data.get(key)));
    if (sortSelect.value !== 'pertinence' || !searchInput.value) params.set('tri', sortSelect.value);
    if (page > 1) params.set('page', String(page));
    history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}`);
    render();
  }

  function syncInputs(state: ReturnType<typeof readState>) {
    searchInput.value = state.q;
    sortSelect.value = state.sort;
    (filtersForm.elements.namedItem('prixMin') as HTMLInputElement).value = state.prixMin;
    (filtersForm.elements.namedItem('prixMax') as HTMLInputElement).value = state.prixMax;
    filtersForm.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((cb) => {
      cb.checked = state.multi[cb.name as (typeof MULTI)[number]]?.includes(cb.value) ?? false;
    });
  }

  let lastTrackedQuery = '';
  let logTimer: number | undefined;

  function render() {
    const state = readState();
    const min = Number(state.prixMin) || 0;
    const max = Number(state.prixMax) || Infinity;

    const scored = items
      .map((el) => ({ el, score: searchScore(state.q, el.dataset.search!) }))
      .filter(({ el, score }) => {
        if (state.q && score === 0) return false;
        const price = Number(el.dataset.price);
        if (price < min || price > max) return false;
        return MULTI.every((key) => {
          const wanted = state.multi[key];
          if (!wanted.length) return true;
          const values = (el.dataset[key] ?? '').split(' ');
          return wanted.some((w) => values.includes(w));
        });
      });

    const num = (el: HTMLElement, k: string) => Number(el.dataset[k]);
    const sorters: Record<string, (a: (typeof scored)[number], b: (typeof scored)[number]) => number> = {
      pertinence: (a, b) => b.score - a.score || num(b.el, 'popularity') - num(a.el, 'popularity'),
      popularite: (a, b) => num(b.el, 'popularity') - num(a.el, 'popularity'),
      nouveautes: (a, b) => num(b.el, 'created') - num(a.el, 'created'),
      'prix-asc': (a, b) => num(a.el, 'price') - num(b.el, 'price'),
      'prix-desc': (a, b) => num(b.el, 'price') - num(a.el, 'price'),
    };
    scored.sort(sorters[state.sort] ?? sorters.popularite);

    const pages = Math.max(1, Math.ceil(scored.length / PAGE_SIZE));
    const page = Math.min(state.page, pages);
    const visible = new Set(scored.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE).map((s) => s.el));

    items.forEach((el) => (el.hidden = !visible.has(el)));
    scored.forEach(({ el }) => grid.appendChild(el));

    const n = scored.length;
    countEl.textContent = state.q
      ? `${n} résultat${n > 1 ? 's' : ''} pour « ${state.q} »`
      : `${n} produit${n > 1 ? 's' : ''}`;
    titleEl.textContent = state.q ? `Résultats pour « ${state.q} »` : 'Boutique';
    emptyEl.hidden = n > 0;
    const ask = emptyEl.querySelector<HTMLAnchorElement>('[data-ask-product]')!;
    ask.href = `/contact?sujet=produit${state.q ? `&message=${encodeURIComponent(`Je cherche : ${state.q}`)}` : ''}`;

    const active = Object.values(state.multi).flat().length + (state.prixMin ? 1 : 0) + (state.prixMax ? 1 : 0);
    activeCount.textContent = String(active);
    activeCount.hidden = active === 0;

    pager.replaceChildren(
      ...(pages > 1
        ? Array.from({ length: pages }, (_, i) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.textContent = String(i + 1);
            b.className = `btn btn-sm min-w-10 ${i + 1 === page ? 'btn-primary' : 'btn-secondary'}`;
            if (i + 1 === page) b.setAttribute('aria-current', 'page');
            b.setAttribute('aria-label', `Page ${i + 1}`);
            b.addEventListener('click', () => {
              writeState(i + 1);
              grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
            return b;
          })
        : []),
    );

    if (state.q && state.q !== lastTrackedQuery) {
      lastTrackedQuery = state.q;
      track('search', { search_term: state.q, results: n });
      // Statistiques internes (recherches sans résultat) : envoyé après une courte pause de saisie.
      clearTimeout(logTimer);
      logTimer = window.setTimeout(() => navigator.sendBeacon?.('/api/search-log', JSON.stringify({ q: state.q, results: n })), 1500);
    }
  }

  let debounce: number | undefined;
  searchInput.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = window.setTimeout(() => writeState(), 250);
  });
  searchForm.addEventListener('submit', (e) => {
    e.preventDefault();
    writeState();
  });
  filtersForm.addEventListener('change', () => writeState());
  filtersForm.addEventListener('reset', () => setTimeout(() => writeState()));
  sortSelect.addEventListener('change', () => writeState());
  document.querySelector('[data-clear]')!.addEventListener('click', () => {
    filtersForm.reset();
    searchInput.value = '';
    setTimeout(() => writeState());
  });

  syncInputs(readState());
  render();
</script>

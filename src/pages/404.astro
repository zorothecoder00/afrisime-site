---
import Layout from '../layouts/Layout.astro';
import { findRedirect } from '../lib/redirects';

// Redirections 301 administrables (back-office › Redirections) : vérifiées seulement pour les adresses inconnues.
const redirect = await findRedirect(Astro.url.pathname).catch(() => undefined);
if (redirect) return Astro.redirect(redirect.to, redirect.status as 301);
Astro.response.status = 404;
---

<Layout title="Page introuvable" noindex>
  <div class="container-page max-w-xl py-24 text-center">
    <p class="text-6xl font-extrabold text-brand-200">404</p>
    <h1 class="mt-4 text-3xl">Cette page est introuvable</h1>
    <p class="mt-3 text-muted">Le lien est peut-être ancien, ou la page a été déplacée.</p>
    <form action="/boutique" method="get" role="search" class="mt-8 flex gap-2">
      <label for="q404" class="sr-only">Rechercher un produit</label>
      <input id="q404" name="q" type="search" class="input" placeholder="Rechercher un produit…" />
      <button class="btn btn-primary">Rechercher</button>
    </form>
    <a href="/" class="btn btn-secondary mt-6">Retour à l'accueil</a>
  </div>
</Layout>

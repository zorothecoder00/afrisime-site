---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { imageUrl } from '../lib/media';
import { listPublishedProjects, PROJECT_STATUSES, type ProjectKind } from '../lib/projects';
import { cardTint } from '../lib/tints';

// Programmes et projets gérés dans le back-office (Programmes & projets).
const projects = await listPublishedProjects();
const sections: { kind: ProjectKind; id: string; title: string }[] = [
  { kind: 'programme', id: 'programmes', title: 'Nos programmes' },
  { kind: 'projet', id: 'projets', title: 'Nos projets' },
];
const statusBadge = { 'a-venir': 'badge-nouveau', 'en-cours': 'badge-populaire', termine: 'badge-sur-commande' } as const;
---

<Layout title="Programmes & Projets" description="Les programmes et projets portés par AfriSime au Togo : filières locales, logistique, accompagnement des partenaires.">
  <PageHero
    eyebrow="Programmes & Projets"
    title="Nos programmes et projets"
    intro="AfriSime s'engage au-delà de la distribution : programmes structurants et projets concrets pour les filières, les partenaires et les communautés."
    breadcrumbs={[{ label: 'Programmes & Projets' }]}
  />

  {
    projects.length === 0 && (
      <section class="section">
        <div class="container-page">
          <p class:list={['card p-6 text-ink/75', cardTint(0)]}>Nos programmes et projets seront bientôt présentés ici.</p>
        </div>
      </section>
    )
  }

  {
    sections.map((s) => {
      const items = projects.filter((p) => p.kind === s.kind);
      return (
        items.length > 0 && (
          <section id={s.id} class="section scroll-mt-32 even:bg-white">
            <div class="container-page">
              <h2 class="text-3xl">{s.title}</h2>
              <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {items.map((p, i) => (
                  <article class:list={['card flex flex-col overflow-hidden', cardTint(i)]}>
                    {p.imageId && <img src={imageUrl(p.imageId)} alt="" loading="lazy" class="aspect-[16/9] w-full object-cover" />}
                    <div class="flex flex-1 flex-col p-6">
                      <p class="flex flex-wrap items-center gap-2 text-sm text-muted">
                        <span class:list={['badge', statusBadge[p.status]]}>{PROJECT_STATUSES[p.status]}</span>
                        {[p.place, p.period].filter(Boolean).join(' · ')}
                      </p>
                      <h3 class="mt-3 text-xl">{p.title}</h3>
                      {p.summary && <p class="mt-2 font-semibold text-ink/80">{p.summary}</p>}
                      {p.text && (
                        <div class="mt-3 space-y-3 text-sm text-muted">
                          {p.text.split(/\n\s*\n/).map((para) => <p class="whitespace-pre-line">{para}</p>)}
                        </div>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </section>
        )
      );
    })
  }
</Layout>

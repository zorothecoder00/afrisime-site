---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Field from '../components/ui/Field.astro';
import Icon from '../components/ui/Icon.astro';
import { getPageTexts } from '../lib/page-texts';

// Textes modifiables dans le back-office (Textes du site › Investir).
const t = await getPageTexts('investir');
---

<Layout title="Investir" description={t.seoDescription}>
  <PageHero eyebrow={t.heroEyebrow} title={t.heroTitle} intro={t.heroText} breadcrumbs={[{ label: 'AfriSime', href: '/afrisime' }, { label: 'Investir' }]} />
  <section class="section">
    <div class="container-page grid gap-4 md:grid-cols-2">
      {t.pillars.map((p) => <article class="card p-7"><Icon name="chart" size={28} class="text-brand-600" /><h2 class="mt-4 text-xl">{p.title}</h2><p class="mt-2 text-muted">{p.text}</p></article>)}
    </div>
  </section>
  <section class="section bg-white">
    <div class="container-page max-w-3xl">
      <h2 class="text-3xl">{t.formTitle}</h2>
      <p class="mt-3 text-muted">{t.formText}</p>
      <form data-lead-form class="card mt-8 grid gap-4 p-6 sm:grid-cols-2 sm:p-8" data-success-message={t.success} novalidate>
        <input type="hidden" name="type" value="investisseur" />
        <input type="hidden" name="source" value="page-investir" />
        <div class="hidden" aria-hidden="true"><input name="website" tabindex="-1" autocomplete="off" /></div>
        <Field name="name" label="Nom complet" required autocomplete="name" />
        <Field name="company" label="Organisation" autocomplete="organization" />
        <Field name="phone" label="Téléphone" type="tel" required autocomplete="tel" />
        <Field name="email" label="E-mail" type="email" autocomplete="email" />
        <Field name="need" label="Objet de votre demande" required textarea class="sm:col-span-2" />
        <div class="sm:col-span-2">
          <label class="flex items-start gap-2 text-sm"><input type="checkbox" name="consent" class="mt-1 size-4 accent-brand-700" />{t.consent}</label>
          <p class="field-error" data-error-for="consent" hidden></p>
        </div>
        <div class="sm:col-span-2">
          <button type="submit" class="btn btn-primary">{t.submit}</button>
          <div data-form-status class="mt-4" hidden role="status"></div>
        </div>
      </form>
    </div>
  </section>
</Layout>

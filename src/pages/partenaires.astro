---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Slideshow from '../components/Slideshow.astro';
import Field from '../components/ui/Field.astro';
import FileField from '../components/ui/FileField.astro';
import Icon, { type IconName } from '../components/ui/Icon.astro';
import { getPageTexts } from '../lib/page-texts';
import { cardTint } from '../lib/tints';

// Textes modifiables dans le back-office (Textes du site › Partenaires). Ancres et icônes restent fixes.
const t = await getPageTexts('partenaires');
const layout: { id: string; icon: IconName }[] = [
  { id: 'fournisseur', icon: 'box' },
  { id: 'depot-vente', icon: 'store' },
  { id: 'commercial', icon: 'handshake' },
  { id: 'grossiste', icon: 'truck' },
];
const offers = t.offers.map((o, i) => ({ ...o, ...layout[i] }));
---

<Layout title="Partenaires & fournisseurs" description={t.seoDescription}>
  <PageHero eyebrow={t.heroEyebrow} title={t.heroTitle} intro={t.heroText} breadcrumbs={[{ label: 'Partenaires' }]} media="entete-partenaires" />

  <section class="section">
    <div class="container-page grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        offers.map((o, i) => (
          <article id={o.id} class:list={['card p-6', cardTint(i)]}>
            <Icon name={o.icon} size={28} class="text-brand-600" />
            <h2 class="mt-4 text-xl">{o.title}</h2>
            <p class="mt-2 text-sm text-muted">{o.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <Slideshow placement="partenaires" class="section !pt-0" />

  <section id="formulaire" class="section scroll-mt-32 bg-white">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_1.5fr]">
      <div>
        <p class="eyebrow">{t.formEyebrow}</p>
        <h2 class="mt-2 text-3xl">{t.formTitle}</h2>
        <p class="mt-3 text-muted">{t.formText}</p>
        <h3 class="mt-8 text-lg">{t.criteriaTitle}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          {t.criteria.map((c) => <li class="flex gap-2"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-brand-600" />{c}</li>)}
        </ul>
      </div>

      <form data-lead-form class="card grid gap-4 p-6 sm:grid-cols-2 sm:p-8" data-success-message={t.success} novalidate>
        <input type="hidden" name="type" value="fournisseur" />
        <input type="hidden" name="source" value="page-partenaires" />
        <div class="hidden" aria-hidden="true"><input name="website" tabindex="-1" autocomplete="off" /></div>

        <Field name="partenariat" label="Type de partenariat" required options={t.partnershipTypes} class="sm:col-span-2" />
        <Field name="company" label="Raison sociale" required autocomplete="organization" />
        <Field name="rccm" label="RCCM / NIF" hint="Si votre structure est enregistrée." />
        <Field name="name" label="Nom du contact" required autocomplete="name" />
        <Field name="phone" label="Téléphone" type="tel" required autocomplete="tel" inputmode="tel" />
        <Field name="email" label="E-mail" type="email" autocomplete="email" />
        <Field name="localisation" label="Localisation" required placeholder="Ville, région" />
        <Field name="need" label="Produits proposés et capacités" required textarea placeholder="Produits, conditionnements, volumes disponibles par mois, prix indicatifs…" class="sm:col-span-2" />
        <Field name="certifications" label="Certifications / agréments" placeholder="Ex. : autorisation de mise sur le marché, bio…" class="sm:col-span-2" />
        <FileField label="Documents (catalogue, fiches produits, RCCM, agréments…)" class="sm:col-span-2" />

        <div class="sm:col-span-2">
          <label class="flex items-start gap-2 text-sm">
            <input type="checkbox" name="consent" class="mt-1 size-4 accent-brand-700" />
            {t.consent}
          </label>
          <p class="field-error" data-error-for="consent" hidden></p>
        </div>
        <div class="sm:col-span-2">
          <button type="submit" class="btn btn-primary w-full !py-4 sm:w-auto">{t.submit}</button>
          <div data-form-status class="mt-4" hidden role="status"></div>
        </div>
      </form>
    </div>
  </section>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/ui/Icon.astro';
import { listArticles } from '../../lib/content';
import { ARTICLE_TYPE_LABELS, formatDate } from '../../lib/format';
import { imageUrl } from '../../lib/media';

const articles = await listArticles();
const types = [...new Set(articles.map((a) => a.type))] as (keyof typeof ARTICLE_TYPE_LABELS)[];
---

<Layout title="Média" description="Actualités, conseils, vidéos, événements et communiqués d'AfriSime.">
  <PageHero eyebrow="Média" title="Actualités & conseils" intro="Nouveautés, conseils pratiques, vidéos, événements et communiqués de presse." breadcrumbs={[{ label: 'Média' }]} />
  <section class="section">
    <div class="container-page">
      {
        articles.length === 0 ? (
          <p class="card p-10 text-center text-muted">Aucune publication pour le moment. Revenez bientôt !</p>
        ) : (
          <>
            <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrer par type">
              <button type="button" class="btn btn-primary btn-sm" data-type="" aria-pressed="true">Tout</button>
              {types.map((t) => <button type="button" class="btn btn-secondary btn-sm" data-type={t} aria-pressed="false">{ARTICLE_TYPE_LABELS[t]}</button>)}
            </div>
            <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {articles.map((a) => (
                <article class="card flex flex-col overflow-hidden" data-article-type={a.type}>
                  {a.coverId && (
                    <a href={`/media/${a.slug}`} tabindex="-1" aria-hidden="true" class="relative block">
                      <img src={imageUrl(a.coverId, 'mini')} alt="" loading="lazy" class="aspect-video w-full object-cover" />
                      {a.type === 'video' && (
                        <span class="absolute inset-0 grid place-items-center text-white">
                          <Icon name="play" size={48} class="drop-shadow" />
                        </span>
                      )}
                    </a>
                  )}
                  <div class="flex flex-1 flex-col p-6">
                    <p class="flex flex-wrap items-center gap-2 text-xs font-semibold text-muted">
                      <span class="badge badge-populaire">{ARTICLE_TYPE_LABELS[a.type as keyof typeof ARTICLE_TYPE_LABELS]}</span>
                      <time datetime={a.publishedAt!.toISOString()}>{formatDate(a.publishedAt!)}</time>
                      {a.type === 'evenement' && a.eventDate && <span>· Le {formatDate(a.eventDate)}</span>}
                    </p>
                    <h2 class="mt-3 text-xl leading-snug">
                      <a href={`/media/${a.slug}`} class="hover:text-brand-600">{a.title}</a>
                    </h2>
                    <p class="mt-2 flex-1 text-sm text-muted">{a.excerpt}</p>
                    <a href={`/media/${a.slug}`} class="mt-4 text-sm font-bold text-brand-700 hover:underline">
                      {a.type === 'video' ? 'Voir la vidéo →' : 'Lire la suite →'}
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-type]');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      buttons.forEach((x) => {
        const on = x === b;
        x.setAttribute('aria-pressed', String(on));
        x.classList.toggle('btn-primary', on);
        x.classList.toggle('btn-secondary', !on);
      });
      document.querySelectorAll<HTMLElement>('[data-article-type]').forEach((el) => {
        el.hidden = !!b.dataset.type && el.dataset.articleType !== b.dataset.type;
      });
    }),
  );
</script>

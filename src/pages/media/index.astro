---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { ARTICLE_TYPE_LABELS, formatDate } from '../../lib/format';

const articles = (await getCollection('articles')).sort((a, b) => +b.data.date - +a.data.date);
const types = [...new Set(articles.map((a) => a.data.type))];
---

<Layout title="Média" description="Actualités, conseils, vidéos, événements et communiqués d'AfriSime.">
  <PageHero eyebrow="Média" title="Actualités & conseils" intro="Nouveautés, conseils pratiques, événements et communiqués de presse." breadcrumbs={[{ label: 'Média' }]} />
  <section class="section">
    <div class="container-page">
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrer par type">
        <button type="button" class="btn btn-primary btn-sm" data-type="" aria-pressed="true">Tout</button>
        {types.map((t) => <button type="button" class="btn btn-secondary btn-sm" data-type={t} aria-pressed="false">{ARTICLE_TYPE_LABELS[t]}</button>)}
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          articles.map((a) => (
            <article class="card flex flex-col p-6" data-article-type={a.data.type}>
              <p class="flex items-center gap-2 text-xs font-semibold text-muted">
                <span class="badge badge-populaire">{ARTICLE_TYPE_LABELS[a.data.type]}</span>
                <time datetime={a.data.date.toISOString()}>{formatDate(a.data.date)}</time>
              </p>
              <h2 class="mt-3 text-xl leading-snug"><a href={`/media/${a.id}`} class="hover:text-brand-600">{a.data.title}</a></h2>
              <p class="mt-2 flex-1 text-sm text-muted">{a.data.excerpt}</p>
              <a href={`/media/${a.id}`} class="mt-4 text-sm font-bold text-brand-700 hover:underline">Lire la suite →</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-type]');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      buttons.forEach((x) => {
        const on = x === b;
        x.setAttribute('aria-pressed', String(on));
        x.classList.toggle('btn-primary', on);
        x.classList.toggle('btn-secondary', !on);
      });
      document.querySelectorAll<HTMLElement>('[data-article-type]').forEach((el) => {
        el.hidden = !!b.dataset.type && el.dataset.articleType !== b.dataset.type;
      });
    }),
  );
</script>

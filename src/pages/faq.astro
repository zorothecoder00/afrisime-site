---
import { FAQ_GROUPS as allGroups, listFaq } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/ui/Icon.astro';
import { getPageTexts } from '../lib/page-texts';
import { cardTint } from '../lib/tints';
import { contactLinks, getSettings } from '../lib/settings';

// Questions : rubrique FAQ ; titres et encadré final : Textes du site › FAQ.
const [faq, settings, t] = await Promise.all([listFaq(), getSettings(), getPageTexts('faq')]);
const links = contactLinks(settings.contact);
// Rubriques sans question publiée masquées.
const groups = allGroups.filter((g) => faq.some((q) => q.group === g.id));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((q) => ({ '@type': 'Question', name: q.question, acceptedAnswer: { '@type': 'Answer', text: q.answer } })),
};
---

<Layout title="FAQ" description={t.seoDescription} jsonLd={jsonLd}>
  <PageHero eyebrow={t.heroEyebrow} title={t.heroTitle} breadcrumbs={[{ label: 'FAQ' }]} />

  <section class="section">
    <div class="container-page grid gap-10 lg:grid-cols-[220px_1fr]">
      <nav aria-label="Rubriques de la FAQ" class="lg:sticky lg:top-40 lg:h-fit">
        <ul class="flex flex-wrap gap-2 lg:flex-col">
          {groups.map((g, gi) => <li><a href={`#${g.id}`} class:list={['btn btn-sm border', cardTint(gi)]}>{g.title}</a></li>)}
        </ul>
      </nav>
      <div class="space-y-12">
        {
          groups.map((g, gi) => (
            <section id={g.id} class="scroll-mt-40">
              <h2 class="text-2xl">{g.title}</h2>
              <div class="mt-4 space-y-3">
                {faq
                  .filter((q) => q.group === g.id)
                  .map((q) => (
                    <details class:list={['card group p-5', cardTint(gi)]}>
                      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-brand-900">
                        {q.question}
                        <Icon name="down" size={18} class="shrink-0 transition group-open:rotate-180" />
                      </summary>
                      <p class="mt-3 text-muted">{q.answer}</p>
                    </details>
                  ))}
              </div>
            </section>
          ))
        }
        <div class="rounded-2xl bg-brand-900 p-8 text-white">
          <h2 class="text-2xl !text-white">{t.ctaTitle}</h2>
          <div class="mt-5 flex flex-col gap-2 sm:flex-row">
            <a href="/contact" class="btn btn-accent">{t.ctaContact}</a>
            <a href={links.whatsappHref} target="_blank" rel="noopener" class="btn border border-white/40 text-white hover:bg-white/10"><Icon name="whatsapp" size={18} />{t.ctaWhatsapp}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

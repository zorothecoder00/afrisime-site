---
import { FAQ_GROUPS as groups, listFaq } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/ui/Icon.astro';
import { contactLinks, getSettings } from '../lib/settings';

const faq = await listFaq();
const links = contactLinks((await getSettings()).contact);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((q) => ({ '@type': 'Question', name: q.question, acceptedAnswer: { '@type': 'Answer', text: q.answer } })),
};
---

<Layout title="FAQ" description="Questions fréquentes sur AfriSime : commande en ligne, paiement, livraison à Lomé et au Togo, achats professionnels." jsonLd={jsonLd}>
  <PageHero eyebrow="Aide" title="Questions fréquentes" breadcrumbs={[{ label: 'FAQ' }]} />

  <section class="section">
    <div class="container-page grid gap-10 lg:grid-cols-[220px_1fr]">
      <nav aria-label="Rubriques de la FAQ" class="lg:sticky lg:top-40 lg:h-fit">
        <ul class="flex flex-wrap gap-2 lg:flex-col">
          {groups.map((g) => <li><a href={`#${g.id}`} class="btn btn-ghost btn-sm">{g.title}</a></li>)}
        </ul>
      </nav>
      <div class="space-y-12">
        {
          groups.map((g) => (
            <section id={g.id} class="scroll-mt-40">
              <h2 class="text-2xl">{g.title}</h2>
              <div class="mt-4 space-y-3">
                {faq
                  .filter((q) => q.group === g.id)
                  .map((q) => (
                    <details class="card group p-5">
                      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-brand-900">
                        {q.question}
                        <Icon name="down" size={18} class="shrink-0 transition group-open:rotate-180" />
                      </summary>
                      <p class="mt-3 text-muted">{q.answer}</p>
                    </details>
                  ))}
              </div>
            </section>
          ))
        }
        <div class="rounded-2xl bg-brand-900 p-8 text-white">
          <h2 class="text-2xl !text-white">Vous n'avez pas trouvé votre réponse ?</h2>
          <div class="mt-5 flex flex-col gap-2 sm:flex-row">
            <a href="/contact" class="btn btn-accent">Nous écrire</a>
            <a href={links.whatsappHref} target="_blank" rel="noopener" class="btn border border-white/40 text-white hover:bg-white/10"><Icon name="whatsapp" size={18} />WhatsApp</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

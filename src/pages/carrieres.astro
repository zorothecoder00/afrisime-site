---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Slideshow from '../components/Slideshow.astro';
import Field from '../components/ui/Field.astro';
import Icon from '../components/ui/Icon.astro';
import { listPublishedJobs } from '../lib/jobs';
import { getPageTexts } from '../lib/page-texts';
import { cardTint } from '../lib/tints';

// Offres gérées dans le back-office (Offres d'emploi) ; textes dans Textes du site › Carrières.
const [jobs, t] = await Promise.all([listPublishedJobs(), getPageTexts('carrieres')]);
---

<Layout title="Carrières" description={t.seoDescription}>
  <PageHero eyebrow={t.heroEyebrow} title={t.heroTitle} intro={t.heroText} breadcrumbs={[{ label: 'AfriSime', href: '/afrisime' }, { label: 'Carrières' }]} />
  <Slideshow placement="carrieres" class="pt-10 sm:pt-14" />

  <section class="section">
    <div class="container-page grid gap-10 lg:grid-cols-[1.5fr_1fr]">
      <div>
        <h2 class="text-2xl">{t.jobsTitle}</h2>
        {jobs.length === 0 && <p class:list={['card mt-6 p-6 text-ink/75', cardTint(0)]}>{t.noJobs}</p>}
        <ul class="mt-6 space-y-3">
          {
            jobs.map((j, i) => (
              <li class:list={['card flex flex-col gap-3 p-6 sm:flex-row sm:items-center sm:justify-between', cardTint(i)]}>
                <div>
                  <h3 class="text-lg">{j.title}</h3>
                  {(j.place || j.contract) && <p class="text-sm text-muted">{[j.place, j.contract].filter(Boolean).join(' · ')}</p>}
                  {j.text && <p class="mt-1 whitespace-pre-line text-sm">{j.text}</p>}
                </div>
                <a href="#candidature" class="btn btn-secondary btn-sm shrink-0" data-job={j.title}>Postuler</a>
              </li>
            ))
          }
        </ul>
      </div>
      <aside class:list={['card h-fit p-6', cardTint(3)]}>
        <h2 class="text-xl">{t.cultureTitle}</h2>
        <ul class="mt-4 space-y-3 text-sm">
          {t.culture.map((c) => <li class="flex gap-2"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-brand-600" />{c}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section id="candidature" class="section scroll-mt-32 bg-white">
    <div class="container-page max-w-3xl">
      <h2 class="text-3xl">{t.formTitle}</h2>
      <p class="mt-2 text-muted">{t.formText}</p>
      <form data-lead-form class:list={['card mt-8 grid gap-4 p-6 sm:grid-cols-2 sm:p-8', cardTint(0)]} data-success-message={t.success} novalidate>
        <input type="hidden" name="type" value="candidature" />
        <input type="hidden" name="source" value="page-carrieres" />
        <div class="hidden" aria-hidden="true"><input name="website" tabindex="-1" autocomplete="off" /></div>
        <Field name="poste" label="Poste visé" required options={[...jobs.map((j) => j.title), t.spontaneous]} class="sm:col-span-2" />
        <Field name="name" label="Nom complet" required autocomplete="name" />
        <Field name="phone" label="Téléphone" type="tel" required autocomplete="tel" />
        <Field name="email" label="E-mail" type="email" autocomplete="email" />
        <Field name="lien" label="Lien vers votre CV / LinkedIn" type="url" />
        <Field name="need" label="Présentez-vous en quelques lignes" required textarea class="sm:col-span-2" />
        <div class="sm:col-span-2">
          <label class="flex items-start gap-2 text-sm"><input type="checkbox" name="consent" class="mt-1 size-4 accent-brand-700" />{t.consent}</label>
          <p class="field-error" data-error-for="consent" hidden></p>
        </div>
        <div class="sm:col-span-2">
          <button type="submit" class="btn btn-primary">{t.submit}</button>
          <div data-form-status class="mt-4" hidden role="status"></div>
        </div>
      </form>
    </div>
  </section>
</Layout>

<script>
  const select = document.querySelector<HTMLSelectElement>('select[name="poste"]');
  document.querySelectorAll<HTMLAnchorElement>('[data-job]').forEach((a) =>
    a.addEventListener('click', () => select && (select.value = a.dataset.job!)),
  );
</script>

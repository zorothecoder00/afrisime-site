---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/ui/Icon.astro';
import { SITE } from '../data/site';
---

<Layout title="Mon compte" noindex>
  <PageHero
    title="Mon compte"
    intro="L'espace client arrive bientôt : profil, historique de commandes, adresses, favoris et recommande en un clic."
    breadcrumbs={[{ label: 'Mon compte' }]}
  />
  <div class="container-page grid gap-4 py-12 md:grid-cols-3">
    <a href="/boutique" class="card p-6 hover:border-brand-600">
      <Icon name="cart" class="text-brand-600" />
      <h2 class="mt-3 text-lg">Commander sans compte</h2>
      <p class="mt-1 text-sm text-muted">La commande en tant que visiteur est déjà disponible.</p>
    </a>
    <a href="/contact" class="card p-6 hover:border-brand-600">
      <Icon name="box" class="text-brand-600" />
      <h2 class="mt-3 text-lg">Suivre une commande</h2>
      <p class="mt-1 text-sm text-muted">Contactez-nous avec votre numéro de commande.</p>
    </a>
    <a href="/b2b#devis" class="card p-6 hover:border-brand-600">
      <Icon name="building" class="text-brand-600" />
      <h2 class="mt-3 text-lg">Compte professionnel</h2>
      <p class="mt-1 text-sm text-muted">Demandez l'ouverture d'un compte pro auprès d'un commercial.</p>
    </a>
  </div>
  <p class="container-page pb-12 text-sm text-muted">
    Besoin d'aide ? <a href={SITE.contact.phoneHref} class="font-semibold underline">{SITE.contact.phone}</a>
  </p>
</Layout>

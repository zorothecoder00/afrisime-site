---
import AuthShell from '../../components/AuthShell.astro';
import Field from '../../components/ui/Field.astro';

export const prerender = false;
---

<AuthShell title="Mot de passe oublié" intro="Indiquez votre adresse e-mail : nous vous enverrons un lien pour choisir un nouveau mot de passe.">
  <form class="space-y-4" data-forgot novalidate>
    <p data-form-status hidden tabindex="-1"></p>
    <Field name="email" label="Adresse e-mail" type="email" required autocomplete="email" inputmode="email" />
    <button type="submit" class="btn btn-primary w-full">Envoyer le lien</button>
  </form>
  <p class="mt-6 text-center text-sm"><a href="/compte/connexion" class="font-semibold text-brand-700 underline">Retour à la connexion</a></p>
</AuthShell>

<script>
  import { authClient } from '../../lib/auth-client';
  import { isValidEmail } from '../../lib/validation';
  import { bindForm, errorMessage, showStatus } from '../../scripts/auth-forms';

  const form = document.querySelector<HTMLFormElement>('form[data-forgot]')!;
  bindForm(form, async (data) => {
    const email = String(data.get('email') ?? '').trim();
    if (!isValidEmail(email)) return 'Adresse e-mail invalide.';
    const { error } = await authClient.requestPasswordReset({ email, redirectTo: '/compte/nouveau-mot-de-passe' });
    if (error) return errorMessage(error);
    // Même message que le compte existe ou non, pour ne pas révéler les adresses inscrites.
    showStatus(form, 'success', 'Si un compte existe pour cette adresse, un lien vient de vous être envoyé. Pensez à vérifier vos courriers indésirables.');
    form.reset();
  });
</script>

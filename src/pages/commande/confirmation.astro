---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/ui/Icon.astro';
import { SITE } from '../../data/site';
---

<Layout title="Commande confirmée" noindex>
  <div class="container-page max-w-3xl py-12">
    <div class="card p-8 text-center" data-missing hidden>
      <h1 class="text-2xl">Aucune commande récente</h1>
      <p class="mt-2 text-muted">Si vous venez de commander, vérifiez votre e-mail ou contactez-nous avec votre numéro de commande.</p>
      <div class="mt-6 flex justify-center gap-2">
        <a href="/boutique" class="btn btn-primary">Retour à la boutique</a>
        <a href="/contact" class="btn btn-secondary">Nous contacter</a>
      </div>
    </div>

    <div data-order hidden>
      <div class="text-center">
        <span class="mx-auto grid size-16 place-items-center rounded-full bg-brand-100 text-brand-700"><Icon name="check" size={32} /></span>
        <h1 class="mt-5 text-3xl sm:text-4xl">Merci, votre commande est enregistrée !</h1>
        <p class="mt-3 text-muted">Numéro de commande</p>
        <p class="mt-1 text-2xl font-extrabold tracking-wider text-brand-900" data-number></p>
        <p class="mt-2 text-sm text-muted">Conservez ce numéro : il vous sera demandé pour tout suivi.</p>
      </div>

      <div class="alert-info alert mt-8" data-payment-note hidden>
        Paiement en attente : notre prestataire de paiement sera branché à cette étape. Pour ce prototype, un conseiller vous contactera pour finaliser le paiement.
      </div>

      <section class="card mt-8 p-6" aria-labelledby="recap">
        <h2 id="recap" class="text-xl">Récapitulatif</h2>
        <ul class="mt-4 divide-y divide-line text-sm" data-lines></ul>
        <dl class="mt-4 space-y-1 border-t border-line pt-4 text-sm">
          <div class="flex justify-between"><dt>Sous-total</dt><dd data-subtotal></dd></div>
          <div class="flex justify-between" data-discount-row><dt>Remise</dt><dd data-discount></dd></div>
          <div class="flex justify-between"><dt>Livraison</dt><dd data-delivery></dd></div>
          <div class="flex justify-between pt-2 text-lg font-extrabold text-brand-900"><dt>Total</dt><dd data-total></dd></div>
        </dl>
      </section>

      <section class="card mt-6 p-6" aria-labelledby="suite">
        <h2 id="suite" class="text-xl">Et maintenant ?</h2>
        <ol class="mt-4 space-y-4 text-sm">
          <li class="flex gap-3"><span class="grid size-7 shrink-0 place-items-center rounded-full bg-brand-900 text-xs font-bold text-white">1</span><span>Vous recevez une confirmation par e-mail à <strong data-email></strong>.</span></li>
          <li class="flex gap-3"><span class="grid size-7 shrink-0 place-items-center rounded-full bg-brand-900 text-xs font-bold text-white">2</span><span>Un conseiller vous appelle au <strong data-phone></strong> pour confirmer le créneau.</span></li>
          <li class="flex gap-3"><span class="grid size-7 shrink-0 place-items-center rounded-full bg-brand-900 text-xs font-bold text-white">3</span><span>Votre commande est préparée puis livrée, ou prête au retrait au dépôt.</span></li>
        </ol>
      </section>

      <div class="mt-8 flex flex-col justify-center gap-2 sm:flex-row">
        <a href="/boutique" class="btn btn-primary">Continuer mes achats</a>
        <a href="/suivi" class="btn btn-secondary">Suivre ma commande</a>
        <a href={SITE.contact.whatsapp} target="_blank" rel="noopener" class="btn btn-secondary"><Icon name="whatsapp" size={18} />Suivre sur WhatsApp</a>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { formatPrice } from '../../lib/format';

  let order: any = null;
  try {
    order = JSON.parse(sessionStorage.getItem('afs-last-order') ?? 'null');
  } catch {}

  const $ = (sel: string) => document.querySelector<HTMLElement>(sel)!;
  if (!order) {
    $('[data-missing]').hidden = false;
  } else {
    $('[data-order]').hidden = false;
    $('[data-number]').textContent = order.number;
    $('[data-email]').textContent = order.customer.email;
    $('[data-phone]').textContent = order.customer.phone;
    $('[data-payment-note]').hidden = order.status !== 'en-attente-paiement';
    $('[data-lines]').replaceChildren(
      ...order.lines.map((l: any) => {
        const li = document.createElement('li');
        li.className = 'flex justify-between gap-3 py-2';
        const a = document.createElement('span');
        a.textContent = `${l.name} × ${l.quantity}`;
        const b = document.createElement('span');
        b.className = 'font-semibold';
        b.textContent = formatPrice(l.unitPrice * l.quantity);
        li.append(a, b);
        return li;
      }),
    );
    $('[data-subtotal]').textContent = formatPrice(order.totals.subtotal);
    $('[data-discount-row]').hidden = order.totals.discount === 0;
    $('[data-discount]').textContent = `− ${formatPrice(order.totals.discount)}`;
    $('[data-delivery]').textContent = order.totals.delivery ? formatPrice(order.totals.delivery) : 'Gratuite';
    $('[data-total]').textContent = formatPrice(order.totals.total);
  }
</script>

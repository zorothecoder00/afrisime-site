---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { SITE } from '../data/site';
import { imageUrl } from '../lib/media';
import { getSettings } from '../lib/settings';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Image de la médiathèque utilisée pour le partage (prioritaire sur `image`). */
  imageId?: string | null;
  /** Données structurées Schema.org propres à la page. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { identity, contact, social, seo } = await getSettings();
const { title, description = identity.description, imageId, jsonLd, noindex = false } = Astro.props;
const image = imageId ? imageUrl(imageId) : (Astro.props.image ?? '/og-default.png');
const fullTitle = title ? `${title} | ${identity.name}` : `${identity.name} — ${identity.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: identity.name,
  url: Astro.site?.href,
  logo: new URL('/logo.png', Astro.site).href,
  telephone: contact.phone,
  email: contact.email,
  address: { '@type': 'PostalAddress', streetAddress: contact.address, addressCountry: 'TG' },
  sameAs: social.map((s) => s.href),
};
const structured = [organization, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
// Échappe « < » : une valeur saisie dans le back-office ne peut pas fermer la balise des données structurées.
const structuredJson = JSON.stringify(structured).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {seo.googleVerification && <meta name="google-site-verification" content={seo.googleVerification} />}
    <meta name="theme-color" content="#0f3d2e" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={identity.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />

    <script is:inline type="application/ld+json" set:html={structuredJson} />
  </head>
  <body class="flex min-h-screen flex-col" data-gtm={seo.gtmId || undefined}>
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] btn btn-primary">
      Aller au contenu
    </a>
    <Header />
    <main id="contenu" class="flex-1">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <script>
      import '../scripts/cart';
      import '../scripts/forms';
      import '../scripts/favorites';
      import { loadTagManager } from '../scripts/analytics';
      loadTagManager();
    </script>
  </body>
</html>

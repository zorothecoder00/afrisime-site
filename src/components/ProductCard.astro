---
import Icon from './ui/Icon.astro';
import ProductVisual from './ui/ProductVisual.astro';
import { canBuyOnline, cartPayload, lowestVariant, type Brand, type Category, type Product } from '../lib/catalog';
import { BADGE_LABELS, STATUS_LABELS, formatPrice } from '../lib/format';

interface Props {
  product: Product;
  category: Category;
  brand: Brand;
}
const { product, category, brand } = Astro.props;
const p = product.data;
const variant = lowestVariant(product);
const href = `/boutique/${product.id}`;
const statusColor = {
  disponible: 'text-brand-600',
  'sur-commande': 'text-warning',
  indisponible: 'text-danger',
  devis: 'text-info',
}[p.status];
---

<article class="card group flex flex-col overflow-hidden transition hover:-translate-y-0.5 hover:shadow-lg">
  <a href={href} class="relative block" tabindex="-1" aria-hidden="true">
    <ProductVisual name={p.name} color={category.data.color} icon={category.data.icon} class="aspect-[4/3]" />
    {
      p.badges.length > 0 && (
        <div class="absolute left-3 top-3 flex flex-wrap gap-1">
          {p.badges.map((b) => (
            <span class={`badge badge-${b}`}>{BADGE_LABELS[b]}</span>
          ))}
        </div>
      )
    }
  </a>
  <div class="flex flex-1 flex-col p-4">
    <p class="text-xs font-semibold text-muted">{brand.data.name} · {category.data.name}</p>
    <h3 class="mt-1 text-base !font-bold leading-snug">
      <a href={href} class="hover:text-brand-600">{p.name}</a>
    </h3>
    <p class={`mt-1 flex items-center gap-1 text-xs font-semibold ${statusColor}`}>
      <span class="inline-block size-1.5 rounded-full bg-current"></span>{STATUS_LABELS[p.status]}
    </p>
    <div class="mt-auto flex items-end justify-between gap-2 pt-4">
      {
        p.status === 'devis' ? (
          <p class="text-sm font-bold text-info">Prix sur devis</p>
        ) : (
          <p class="leading-tight">
            {p.variants.length > 1 && <span class="block text-[11px] text-muted">à partir de</span>}
            <span class="text-lg font-extrabold text-brand-900">{formatPrice(variant.price)}</span>
            {variant.compareAtPrice && (
              <s class="ml-1 text-xs text-muted">{formatPrice(variant.compareAtPrice)}</s>
            )}
            <span class="block text-[11px] text-muted">{variant.label}</span>
          </p>
        )
      }
      {
        canBuyOnline(product) ? (
          <button
            type="button"
            class="btn btn-primary btn-sm shrink-0"
            data-add-to-cart={cartPayload(product, category.data.color)}
            aria-label={`Ajouter ${p.name} (${variant.label}) au panier`}
          >
            <Icon name="plus" size={16} />Ajouter
          </button>
        ) : p.status === 'devis' ? (
          <a href={`/b2b?produit=${encodeURIComponent(p.name)}#devis`} class="btn btn-secondary btn-sm shrink-0">Devis</a>
        ) : (
          <a href={href} class="btn btn-secondary btn-sm shrink-0">Détails</a>
        )
      }
    </div>
  </div>
</article>

---
// Champ de formulaire accessible : label associé, aide, zone d'erreur annoncée.
interface Props {
  name: string;
  label: string;
  type?: string;
  required?: boolean;
  placeholder?: string;
  hint?: string;
  autocomplete?: string;
  value?: string;
  textarea?: boolean;
  options?: string[];
  inputmode?: 'text' | 'tel' | 'email' | 'numeric';
  class?: string;
}
const {
  name,
  label,
  type = 'text',
  required = false,
  placeholder,
  hint,
  autocomplete,
  value,
  textarea = false,
  options,
  inputmode,
  class: className,
} = Astro.props;
const id = `f-${name}-${Math.random().toString(36).slice(2, 7)}`;
const describedBy = [hint && `${id}-hint`, `${id}-err`].filter(Boolean).join(' ');
---

<div class={className}>
  <label for={id} class="label">
    {label}{required ? <span class="text-danger" aria-hidden="true"> *</span> : <span class="font-normal text-muted"> (facultatif)</span>}
  </label>
  {
    textarea ? (
      <textarea id={id} name={name} rows="4" required={required} placeholder={placeholder} class="input" aria-describedby={describedBy}>{value}</textarea>
    ) : options ? (
      <select id={id} name={name} required={required} class="input" aria-describedby={describedBy}>
        <option value="">Choisir…</option>
        {options.map((o) => <option selected={o === value}>{o}</option>)}
      </select>
    ) : (
      <input
        id={id}
        name={name}
        type={type}
        required={required}
        placeholder={placeholder}
        autocomplete={autocomplete}
        inputmode={inputmode}
        value={value}
        class="input"
        aria-describedby={describedBy}
      />
    )
  }
  {hint && <p id={`${id}-hint`} class="hint">{hint}</p>}
  <p id={`${id}-err`} class="field-error" data-error-for={name} hidden aria-live="polite"></p>
</div>

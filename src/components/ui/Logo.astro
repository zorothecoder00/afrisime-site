---
// Logo officiel AfriSime (public/logo.webp, fond transparent, tiré de public/logo1.jpeg).
// Sur fond foncé (pied de page), il est posé sur une pastille claire pour rester lisible.
interface Props {
  inverted?: boolean;
  class?: string;
}
const { inverted = false, class: className } = Astro.props;
---

<span class:list={['inline-flex items-center', inverted && 'rounded-xl bg-white px-3 py-2', className]}>
  <img src="/logo.webp" alt="AfriSime Communauté" width="420" height="110" class="h-10 w-auto sm:h-11" decoding="async" />
</span>

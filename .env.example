# Copier ce fichier en .env et renseigner les valeurs. Détail de chaque variable : docs/deploiement.md

# PostgreSQL local, ou URL « pooled » de Neon en production (…-pooler…/neondb?sslmode=require)
DATABASE_URL=postgres://postgres:motdepasse@localhost:5432/afrisime-site
# Neon uniquement : URL directe (sans -pooler), utilisée par les migrations
DATABASE_URL_UNPOOLED=

# Authentification. Générer le secret avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# URL publique du site (http://localhost:4321 en local)
BETTER_AUTH_URL=http://localhost:4321
# Domaine public utilisé au build (canonical, sitemap)
SITE_URL=http://localhost:4321

# Paiement en ligne : fedapay, ou simulation (développement uniquement)
PAYMENT_PROVIDER=simulation
FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=sandbox

# E-mails : resend ou brevo (sans clé, les envois sont seulement journalisés)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM="AfriSime <commandes@votre-domaine.com>"
# Adresse de l'équipe qui reçoit une alerte à chaque commande et demande
STAFF_NOTIFY_EMAIL=
# Passerelle SMS / WhatsApp (reçoit { channel, to, message }, signé avec le secret)
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

# Intégrations facultatives (sans elles, les données restent en base et sont renvoyées plus tard)
CRM_API_URL=
CRM_API_TOKEN=
ERP_API_URL=
ERP_API_TOKEN=
# Secret que l'ERP envoie (Authorization: Bearer …) : webhooks statut de commande et catalogue
ERP_WEBHOOK_SECRET=

# Tâche planifiée /api/cron/sync (Vercel Cron l'envoie automatiquement)
CRON_SECRET=
